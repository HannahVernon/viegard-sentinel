        Enum.GetValues<MikroTikRouterTransportMode>();

    private bool IsEditing(MikroTikRouter router) =>
        EditRouter == router.Id;

    private bool IsConfirmingDelete(MikroTikRouter router) =>
        ConfirmDeleteRouter == router.Id;

    private static string RouterEditHref(MikroTikRouter router) =>
        $"/configuration?editRouter={router.Id:N}#routers";

    private static string RouterDeleteHref(MikroTikRouter router) =>
        $"/configuration?confirmDeleteRouter={router.Id:N}#routers";

    private MikroTikRouterTransportMode EditTransportMode(MikroTikRouter router) =>
        IsEditing(router) && MikroTikRouterValidator.IsLowerHexSha256(RouterPin)
            ? MikroTikRouterTransportMode.HttpsPinned
            : router.TransportMode;

    private string EditPinnedFingerprint(MikroTikRouter router) =>
        IsEditing(router) && MikroTikRouterValidator.IsLowerHexSha256(RouterPin)
            ? RouterPin!
            : router.PinnedCertificateSha256 ?? string.Empty;

    private static string TransportOptionLabel(MikroTikRouterTransportMode mode) =>
        mode switch
        {
            MikroTikRouterTransportMode.PlainHttp => "Plain HTTP",
            MikroTikRouterTransportMode.HttpsTrustAny => "HTTPS, trust any certificate",
            MikroTikRouterTransportMode.HttpsPinned => "HTTPS, pinned certificate",
            _ => mode.ToString(),
        };

    private static string TransportDisplay(MikroTikRouter router) =>
        router.TransportMode switch
        {
            MikroTikRouterTransportMode.PlainHttp => "Plain HTTP",
            MikroTikRouterTransportMode.HttpsTrustAny => "HTTPS (trust any certificate)",
            MikroTikRouterTransportMode.HttpsPinned when router.PinnedCertificateSha256 is { Length: >= 12 } fingerprint =>
                $"HTTPS (pinned {fingerprint[..12]}...)",
            MikroTikRouterTransportMode.HttpsPinned => "HTTPS (pinned)",
            _ => router.TransportMode.ToString(),
        };

