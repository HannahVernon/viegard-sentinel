<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package source explicitly so restores are reproducible for every
  contributor and cannot be redirected by ambient machine-level feeds
  (dependency-confusion hardening; security-audit finding, 2026-08-25).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
