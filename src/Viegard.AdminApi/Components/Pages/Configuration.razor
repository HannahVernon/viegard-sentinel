    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _settings = await RetentionSettingsStore.GetAsync().ConfigureAwait(false);
        _jetPackSettings = await JetPackFeedSettingsStore.GetAsync().ConfigureAwait(false);
        _localModelAdvisorSettings = await LocalModelAdvisorSettingsStore.GetAsync().ConfigureAwait(false);
        _localModelAdvisorCategoryBands = await LocalModelAdvisorCategoryBandStore.ListAsync().ConfigureAwait(false);
        _localModelAdvisorInjectionPatterns = await LocalModelAdvisorInjectionPatternStore.ListAsync().ConfigureAwait(false);
        _localModelAdvisorPromptTemplateRevisions = await LocalModelAdvisorPromptTemplateStore.ListAsync(AdvisoryIncidentClassifier.PromptTemplateId).ConfigureAwait(false);
        _thresholdSettings = await PolicyThresholdSettingsStore.GetAsync().ConfigureAwait(false);
        _classifierSettings = await ClassifierSettingsStore.GetAsync().ConfigureAwait(false);
        _burstSettings = await BurstDetectionSettingsStore.GetAsync().ConfigureAwait(false);
        _coalescingSettings = await IncidentCoalescingSettingsStore.GetAsync().ConfigureAwait(false);
        _sessionSecuritySettings = await SessionSecuritySettingsStore.GetAsync().ConfigureAwait(false);
        _postureSettings = await PolicyPostureSettingsStore.GetAsync().ConfigureAwait(false);
        _lastCycleCounts = _settings?.LastCycleCounts() ?? RetentionSettings.EmptyCounts();
        _mdaemonFilters = (await IngestionFilters
                .ListForSourceAsync(MDaemonIngestionFilterPolicy.SourceType)
                .ConfigureAwait(false))
            .GroupBy(filter => filter.EventKind, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.OrderByDescending(filter => filter.UpdatedAt).First(), StringComparer.Ordinal);
        _satelliteRoles = await SatelliteRoles.ListAsync().ConfigureAwait(false);
        _routers = await Routers.ListAsync().ConfigureAwait(false);
        var commandTargets = await HostUpgrades.ListTargetsAsync().ConfigureAwait(false);
        var registrations = await InstanceRegistry.ListAsync().ConfigureAwait(false);
        _hostUpgradeTargets = HostUpgradeTargetList.BuildKnownTargets(commandTargets, registrations);
        _hostUpgradeCommands = await HostUpgrades.ListRecentAsync().ConfigureAwait(false);
        _now = DateTimeOffset.UtcNow;

        var context = HttpContextAccessor.HttpContext;
        if (context is null)
        {
            return;
        }

        _satelliteCredential = SatelliteCredentialCookie.ReadAndClear(context);

        if (Guid.TryParse(context.User.FindFirstValue(AdminCookieNames.SessionIdClaim), out var sessionId))
        {
            var session = await Sessions.GetAsync(sessionId).ConfigureAwait(false);
            _stepUpFresh = session?.StepUpAt?.Add(SessionSecuritySettings.CurrentValues(SessionSecurityOptions.Value).StepUpValidity) >= DateTimeOffset.UtcNow;
        }

        if (Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            var credentials = await Users.ListWebAuthnCredentialsAsync(userId).ConfigureAwait(false);
            _hasSecurityKeys = credentials.Count > 0;
        }
    }

    private string FormatPeriod(RetentionTarget target) =>
        _settings?.GetDays(target) is { } days
            ? $"{days.ToString(System.Globalization.CultureInfo.InvariantCulture)} day(s)"
            : "Keep forever";

    private static string FormatConfidence(double value) =>
        value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatMinutes(TimeSpan value) =>
        $"{Math.Max(1, (int)Math.Round(value.TotalMinutes, MidpointRounding.AwayFromZero)).ToString(System.Globalization.CultureInfo.InvariantCulture)} minute(s)";

    private static string JetPackIntervalMinutes(JetPackFeedSettings settings) =>
        Math.Max(1, (int)Math.Round(settings.FetchInterval.TotalMinutes, MidpointRounding.AwayFromZero))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string PeriodValue(RetentionTarget target) =>
        _settings?.GetDays(target)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private string FormatLastCycleCount(RetentionTarget target) =>
        _lastCycleCounts.GetValueOrDefault(target).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string SuppressedMdaemonKinds
    {
        get
        {
            var names = MDaemonIngestionFilterPolicy.Descriptors
                .Where(IsMdaemonKindSuppressed)
                .Select(descriptor => descriptor.EventKindName)
                .ToList();
            return names.Count == 0 ? "None" : string.Join(", ", names);
        }
    }

    private string MdaemonFiltersLastChanged
    {
        get
        {
            var latest = _mdaemonFilters.Values
                .OrderByDescending(filter => filter.UpdatedAt)
                .FirstOrDefault();
            return latest is null
                ? "No ingestion filters saved yet."
                : $"{latest.UpdatedBy} at {Display.Format(latest.UpdatedAt)}";
        }
    }

    private bool IsMdaemonKindSuppressed(IngestionFilterDescriptor descriptor) =>
        !descriptor.Locked
        && _mdaemonFilters.TryGetValue(descriptor.EventKindName, out var filter)
        && filter.Suppressed;

    private string MdaemonKindState(IngestionFilterDescriptor descriptor)
    {
        if (descriptor.Locked)
        {
            return "Locked, always emitted";
        }

        return IsMdaemonKindSuppressed(descriptor) ? "Suppressed" : "Emitted";
    }

    private bool IsConfirmingRevoke(SatelliteRoleInfo role) =>
        SatelliteRoleName.TryNormalize(ConfirmRevoke, out var confirmed, out _)
        && string.Equals(confirmed.SatelliteName, role.SatelliteName, StringComparison.Ordinal);

