@page "/decisions"
@attribute [Authorize]
@inject IDecisionStore DecisionStore
@inject IClassificationStore ClassificationStore
@inject IIncidentStore IncidentStore
@inject IEventStore EventStore
@inject IAdminUserStore Users
@inject IAdminSessionStore Sessions
@inject SessionSecuritySettingsSource SessionSecuritySettings
@inject IOptions<SessionSecurityOptions> SessionSecurityOptions
@inject IOptions<PolicyOptions> PolicyOptions
@inject IPolicyPostureSettingsStore PolicyPostureSettingsStore
@inject IHttpContextAccessor HttpContextAccessor
@inject UserDisplay Display

<PageTitle>Viegard decisions</PageTitle>

<main class="admin-panel wide">
    <h1>Decisions</h1>
    <FlashBanner />

    @if (_searchTimedOut)
    {
        <p class="message error">The search took too long and was stopped after 60 seconds.  Try a more specific term.</p>
    }

    <form method="get" action="/decisions" class="filter-bar" aria-label="Decision filters">
        <label for="decision-filter-q">
            Search
            <input id="decision-filter-q" name="q" maxlength="@ListFilterText.MaxLength" value="@(_filterText ?? string.Empty)" placeholder="Rationale" />
        </label>
        <label for="decision-filter-outcome">
            Outcome
            <select id="decision-filter-outcome" name="outcome">
                <option value="" selected="@(_outcome is null)">All outcomes</option>
                @foreach (var outcome in Enum.GetValues<DecisionOutcome>())
                {
                    <option value="@outcome" selected="@(_outcome == outcome)">@AdminText.DecisionOutcomeLabel(outcome)</option>
                }
            </select>
        </label>
        <label for="decision-filter-minseverity">
            Min severity
            <input id="decision-filter-minseverity" name="minSeverity" type="number" min="1" max="10" value="@(_minSeverity?.ToString() ?? string.Empty)" placeholder="1-10" />
        </label>
        <label for="decision-filter-maxseverity">
            Max severity
            <input id="decision-filter-maxseverity" name="maxSeverity" type="number" min="1" max="10" value="@(_maxSeverity?.ToString() ?? string.Empty)" placeholder="1-10" />
        </label>
        <label for="decision-filter-unreviewed" class="filter-checkbox">
            <input id="decision-filter-unreviewed" name="unreviewed" type="checkbox" value="1" checked="@_unreviewedOnly" />
            Unreviewed only
        </label>
        @foreach (var parameter in ActiveFilterHiddenParams)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <button type="submit">Filter</button>
        <span class="filter-hint">Syntax: term "a phrase" OR other -exclude</span>
        @if (HasFilters)
        {
            <a class="filter-clear" href="/decisions">Clear</a>
        }
    </form>

    @if (_outcome == DecisionOutcome.RequireApproval)
    {
        <section class="card">
            <h2>Bulk reject</h2>
            <p class="small">Rejects every unreviewed decision awaiting approval whose severity is at or below the chosen value.  Higher-severity decisions stay in the queue for individual review.</p>
            <p><strong>@_bulkCount</strong> unreviewed @(_bulkCount == 1 ? "decision is" : "decisions are") at severity @_bulkSeverity or below.</p>
            <form method="get" action="/decisions" class="decision-review-form">
                <input type="hidden" name="outcome" value="RequireApproval" />
                <input type="hidden" name="unreviewed" value="1" />
                <input type="hidden" name="take" value="@_take" />
                <label>
                    Max severity
                    <select name="maxSeverity">
                        @for (var severity = 1; severity <= 10; severity++)
                        {
                            <option value="@severity" selected="@(severity == _bulkSeverity)">@severity</option>
                        }
                    </select>
                </label>
                <button type="submit" class="secondary-button">Preview</button>
            </form>
            @if (BulkPreviewActive)
            {
                @if (!_stepUpFresh)
                {
                    <div class="step-up-strip">
                        <span>Step-up verification is required before bulk-rejecting decisions.</span>
                        <StepUpPrompt ReturnTo="@BulkPreviewPath" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-bulk-reject" />
                    </div>
                }
                else
                {
                    <form method="post" action="/decisions/bulk-reject" class="decision-review-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="maxSeverity" value="@_maxSeverity" />
                        <button type="submit" class="secondary-button">Reject these @_bulkCount decision@(_bulkCount == 1 ? "" : "s")</button>
                    </form>
                }
            }
            else
            {
                <p class="form-hint">Preview shows exactly the decisions a bulk reject would claim; the reject button appears once the list matches that set.</p>
            }
        </section>
    }

    @if (_rows.Count == 0)
    {
        <p>@(HasFilters ? "No decisions match the current filters." : "No decisions are available.")</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <SortHeader Title="Created" SortKey="@ListSortParser.ToQueryKey(DecisionSortColumn.Created)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/decisions" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="Policy" SortKey="@ListSortParser.ToQueryKey(DecisionSortColumn.Policy)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/decisions" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="Outcome" SortKey="@ListSortParser.ToQueryKey(DecisionSortColumn.Outcome)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/decisions" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="Severity" SortKey="@ListSortParser.ToQueryKey(DecisionSortColumn.Severity)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/decisions" ExtraQueryParams="@_sortHeaderParams" />
                    <th>Review</th>
                    <SortHeader Title="Classification" SortKey="@ListSortParser.ToQueryKey(DecisionSortColumn.Classification)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/decisions" ExtraQueryParams="@_sortHeaderParams" />
                    <th>Triggered by</th>
                    <th>Rationale</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr id="decision-@row.Decision.Id.ToString("N")" tabindex="-1">
                        <td><a href="/decisions/@row.Decision.Id">@Display.Format(row.Decision.CreatedAt)</a></td>
                        <td>@row.Decision.PolicyId @row.Decision.PolicyVersion</td>
                        <td><span class="@AdminText.OutcomeCss(row.Decision.Outcome)">@AdminText.DecisionOutcomeLabel(row.Decision.Outcome)</span></td>
                        <td>@SeverityBadge(row.Classification)</td>
                        <td class="actions-cell">
                            <span class="@ReviewCss(row.Decision)">@ReviewLabel(row.Decision)</span>
                            @if (row.Decision.SupersededAt is not null)
                            {
                                <div class="small">Superseded by a merged decision.</div>
                            }
                            else if (row.Review is not null)
                            {
                                <div class="small">waiting @WaitingAge(row.Decision.CreatedAt)</div>
                                @if (!_stepUpFresh)
                                {
                                    <div class="decision-inline-review">
                                        <span class="small">Verify step-up to review.</span>
                                        <StepUpPrompt ReturnTo="@_stepUpReturnTo" ShowSecurityKey="_hasSecurityKeys" PopoverId="@($"step-up-popover-decision-{row.Decision.Id:N}")" />
                                    </div>
                                }
                                else if (row.Review.Target.Kind == IncidentTargetIpKind.Found && !string.IsNullOrWhiteSpace(row.Review.Target.Ip))
                                {
                                    <div class="decision-inline-review">
                                        <div class="decision-inline-actions">
                                            <form method="post" action="/decisions/review" class="decision-review-form decision-inline-form">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="id" value="@row.Decision.Id" />
                                                <input type="hidden" name="verdict" value="approve" />
                                                <input type="hidden" name="duration" value="@DecisionReviewDurations.OneDay" />
                                                <input type="hidden" name="returnTo" value="@ReviewReturnTo(row.Decision.Id)" />
                                                <button type="submit">Approve</button>
                                            </form>
                                            <form method="post" action="/decisions/review" class="decision-review-form decision-inline-form">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="id" value="@row.Decision.Id" />
                                                <input type="hidden" name="verdict" value="reject" />
                                                <input type="hidden" name="returnTo" value="@ReviewReturnTo(row.Decision.Id)" />
                                                <button type="submit" class="secondary-button">Reject</button>
                                            </form>
                                        </div>
                                        @if (_dryRunPosture)
                                        {
                                            <div class="small">Dry-run: approval queues the action, but bans nothing until dry-run is disabled.</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="decision-inline-review">
                                        <span class="small">Approval unavailable: @row.Review.Target.Detail</span>
                                        <div class="decision-inline-actions">
                                            <form method="post" action="/decisions/review" class="decision-review-form decision-inline-form">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="id" value="@row.Decision.Id" />
                                                <input type="hidden" name="verdict" value="reject" />
                                                <input type="hidden" name="returnTo" value="@ReviewReturnTo(row.Decision.Id)" />
                                                <button type="submit" class="secondary-button">Reject</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                        </td>
                        <td>@ClassificationSummary(row.Classification)</td>
                        <td>@AdminText.OneLine(row.TriggeredBy, TriggeredByListMaxChars)</td>
                        <td>
                            @if (HasDetail(row))
                            {
                                <button
                                    type="button"
                                    class="rationale-toggle"
                                    data-rationale-toggle="@row.Decision.Id.ToString("N")"
                                    aria-expanded="false"
                                    aria-controls="@($"decision-rationale-{row.Decision.Id:N}")"
                                    aria-label="Show rationale">
                                    +
                                </button>
                            }
                            else
                            {
                                <span class="small">-</span>
                            }
                        </td>
                    </tr>
                    @if (HasDetail(row))
                    {
                        <tr id="@($"decision-rationale-{row.Decision.Id:N}")" class="details-row rationale-detail-row" data-rationale-detail="@row.Decision.Id.ToString("N")" hidden>
                            <td colspan="8">
                                @if (HasRationale(row.Decision))
                                {
                                    <strong>Rationale</strong>
                                    <div class="rationale-detail-text">@row.Decision.Rationale</div>
                                }
                                @if (row.Events.Count > 0)
                                {
                                    <div class="rationale-events">
                                        <p class="rationale-events-summary">
                                            <strong>Associated events:</strong>
                                            @row.TotalEventCount@(row.TotalEventCount == 1 ? " event" : " events") found.
                                            @{ var sources = DistinctSourceAddresses(row.Events); }
                                            @if (sources.Count > 0)
                                            {
                                                <span> Source @(sources.Count == 1 ? "address" : "addresses"): @string.Join(", ", sources).</span>
                                            }
                                            @{ var span = EventTimeSpan(row.Events); }
                                            @if (span is not null)
                                            {
                                                <span> Time span: @span.</span>
                                            }
                                        </p>
                                        @foreach (var evt in row.Events)
                                        {
                                            <article class="rationale-event">
                                                <h5 class="rationale-event-head">
                                                    <a href="/events/@evt.Id">@AdminText.ShortId(evt.Id)</a>
                                                    <span class="rationale-event-meta">
                                                        @Display.Format(evt.OccurredAt) &middot; @AdminText.PayloadTypeName(evt.Payload) &middot; @evt.SourceId (@evt.SourceType)
                                                    </span>
                                                </h5>
                                                @{ var fields = NonEmptyPayloadFields(evt.Payload); }
                                                @if (fields.Count > 0)
                                                {
                                                    <table class="data-table key-value-table">
                                                        <tbody>
                                                            @foreach (var field in fields)
                                                            {
                                                                <tr><th>@field.Name</th><td>@field.Value</td></tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                                else
                                                {
                                                    <p class="small">@AdminText.PayloadSummary(evt.Payload)</p>
                                                }
                                            </article>
                                        }
                                        @if (row.TotalEventCount > row.Events.Count && row.IncidentId is not null)
                                        {
                                            <p class="small">
                                                Showing @row.Events.Count of @row.TotalEventCount events.
                                                <a href="/incidents/@row.IncidentId">Open the incident</a> for the full list.
                                            </p>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <KeysetPagination BasePath="/decisions" CurrentCursor="_currentCursor" PreviousCursor="_previousCursor" NextCursor="_page.NextCursor" Take="_take" TotalCount="_page.TotalCount" Preceding="_page.Preceding" Filters="_filters" />
    }
</main>

@code {
    private KeysetPage<Decision> _page = new([], null, 0, 0);
    private IReadOnlyList<DecisionRow> _rows = [];
    private Guid? _currentCursor;
    private Guid? _previousCursor;
    private IReadOnlyDictionary<string, string?> _filters = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _sortHeaderParams = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _filterHiddenParams = new Dictionary<string, string?>();
    private string? _filterText;
    private bool _searchTimedOut;
    private DecisionOutcome? _outcome;
    private int? _minSeverity;
    private int? _maxSeverity;
    private bool _unreviewedOnly;
    private string? _sortKey;
    private SortDirection? _sortDirection;
    private bool _stepUpFresh;
    private bool _hasSecurityKeys;
    private bool _dryRunPosture;
    private int _bulkSeverity = DefaultBulkSeverity;
    private int _bulkCount;
    private string _stepUpReturnTo = "/decisions";
    private Dictionary<Guid, Guid> _reviewReturnAnchor = new();

    private const int DefaultBulkSeverity = 3;
    private const int TriggeredByListMaxChars = 96;

    private int _take = KeysetPagination.DefaultPageSize;

    private bool HasFilters => _filterText is not null || _outcome is not null
        || _minSeverity is not null || _maxSeverity is not null || _unreviewedOnly;

    // The reject button only renders while the displayed list is exactly the
    // set a bulk reject would claim: RequireApproval, unreviewed, severity at
    // or below the previewed value, with no other narrowing filters.
    private bool BulkPreviewActive => _outcome == DecisionOutcome.RequireApproval
        && _unreviewedOnly
        && _maxSeverity is not null
        && _minSeverity is null
        && _filterText is null;

    private string BulkPreviewPath =>
        $"/decisions?outcome=RequireApproval&unreviewed=1&maxSeverity={_bulkSeverity}";

    private IEnumerable<KeyValuePair<string, string>> ActiveFilterHiddenParams => ActiveParameters(_filterHiddenParams);

    [SupplyParameterFromQuery(Name = "take")]
    public int? Take { get; set; }

    [SupplyParameterFromQuery(Name = "cursor")]
    public Guid? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "prev")]
    public Guid? Prev { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "outcome")]
    public string? OutcomeRaw { get; set; }

    [SupplyParameterFromQuery(Name = "minSeverity")]
    public string? MinSeverityRaw { get; set; }

    [SupplyParameterFromQuery(Name = "maxSeverity")]
    public string? MaxSeverityRaw { get; set; }

    [SupplyParameterFromQuery(Name = "unreviewed")]
    public string? UnreviewedRaw { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _dryRunPosture = (await PolicyPostureSettingsStore.GetAsync().ConfigureAwait(false))?.DryRun
            ?? PolicyOptions.Value.Posture.DryRun;
        _take = Take is null ? Display.DefaultPageSize : KeysetPagination.ClampPageSize(Take);
        _filterText = ListFilterText.Normalize(Q);
        _outcome = ListFilterParser.ParseEnum<DecisionOutcome>(OutcomeRaw);
        _minSeverity = int.TryParse(MinSeverityRaw, out var minSeverity) && minSeverity is >= 1 and <= 10
            ? minSeverity
            : null;
        _maxSeverity = int.TryParse(MaxSeverityRaw, out var maxSeverity) && maxSeverity is >= 1 and <= 10
            ? maxSeverity
            : null;
        _unreviewedOnly = UnreviewedRaw is "1" or "true";
        _bulkSeverity = _maxSeverity ?? DefaultBulkSeverity;
        var sort = ListSortParser.ParseDecision(Sort, Dir);
        if (sort is null && _outcome == DecisionOutcome.RequireApproval)
        {
            // The review queue defaults to highest severity first so urgent
            // items surface at the top; any explicit sort overrides this.
            sort = new ListSort<DecisionSortColumn>(DecisionSortColumn.Severity, SortDirection.Desc);
        }

        _sortKey = sort is { } activeSort ? ListSortParser.ToQueryKey(activeSort.Column) : null;
        _sortDirection = sort?.Direction;
        var direction = _sortDirection is null ? null : ListSortParser.ToQueryValue(_sortDirection.Value);
        var take = _take.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var minSeverityText = _minSeverity?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var maxSeverityText = _maxSeverity?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var unreviewedText = _unreviewedOnly ? "1" : null;
        _filters = new Dictionary<string, string?> { ["q"] = _filterText, ["outcome"] = _outcome?.ToString(), ["minSeverity"] = minSeverityText, ["maxSeverity"] = maxSeverityText, ["unreviewed"] = unreviewedText, ["sort"] = _sortKey, ["dir"] = direction };
        _sortHeaderParams = new Dictionary<string, string?> { ["q"] = _filterText, ["outcome"] = _outcome?.ToString(), ["minSeverity"] = minSeverityText, ["maxSeverity"] = maxSeverityText, ["unreviewed"] = unreviewedText, ["take"] = take };
        _filterHiddenParams = new Dictionary<string, string?> { ["take"] = take, ["sort"] = _sortKey, ["dir"] = direction };
        var filter = new DecisionListFilter(_filterText, _outcome, _minSeverity, _maxSeverity, _unreviewedOnly);
        try
        {
            _currentCursor = Page is { } requestedPage
                ? await DecisionStore.GetPageCursorAsync(requestedPage, _take, filter, sort).ConfigureAwait(false)
                : Cursor;
            _page = await DecisionStore.ListPageAsync(_currentCursor, _take, filter, sort).ConfigureAwait(false);
            _previousCursor = Page is null
                ? Prev
                : await PreviousPageCursorAsync(filter, sort).ConfigureAwait(false);
        }
        catch (Exception ex) when (_filterText is not null && AdminQueryTimeout.IsTimeout(ex))
        {
            // The short search command budget elapsed; render the friendly
            // banner with an empty page instead of the generic error page.
            _searchTimedOut = true;
        }
        _rows = await BuildRowsAsync(_page.Items).ConfigureAwait(false);
        BuildReviewReturnAnchors();

        if (_outcome == DecisionOutcome.RequireApproval)
        {
            _bulkCount = await DecisionStore.CountUnreviewedAtOrBelowAsync(_bulkSeverity).ConfigureAwait(false);
        }

        if ((_outcome == DecisionOutcome.RequireApproval || _rows.Any(static row => row.Review is not null))
            && HttpContextAccessor.HttpContext is { } context)
        {
            _stepUpReturnTo = CurrentListPath(context);
            if (Guid.TryParse(context.User.FindFirstValue(AdminCookieNames.SessionIdClaim), out var sessionId))
            {
                var session = await Sessions.GetAsync(sessionId).ConfigureAwait(false);
                _stepUpFresh = session?.StepUpAt?.Add(SessionSecuritySettings.CurrentValues(SessionSecurityOptions.Value).StepUpValidity) >= DateTimeOffset.UtcNow;
            }

            if (Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
            {
                var credentials = await Users.ListWebAuthnCredentialsAsync(userId).ConfigureAwait(false);
                _hasSecurityKeys = credentials.Count > 0;
            }
        }
    }

    // After a review redirect the operator should land on the row they will act
    // on next, not back at the top of a long queue.  Map each still-reviewable
    // row to the id of the next still-reviewable row in list order, falling back
    // to itself when it is the last one.  Anchoring to the next row is robust to
    // the just-reviewed row changing height (buttons collapse to a badge) or
    // dropping out of the list entirely under the unreviewed-only filter.
    private void BuildReviewReturnAnchors()
    {
        _reviewReturnAnchor = new Dictionary<Guid, Guid>();
        var reviewable = _rows
            .Where(static row => row.Review is not null && row.Decision.SupersededAt is null)
            .Select(static row => row.Decision.Id)
            .ToList();

        for (var i = 0; i < reviewable.Count; i++)
        {
            var next = i + 1 < reviewable.Count ? reviewable[i + 1] : reviewable[i];
            _reviewReturnAnchor[reviewable[i]] = next;
        }
    }

    private string ReviewReturnTo(Guid decisionId) =>
        _reviewReturnAnchor.TryGetValue(decisionId, out var anchor)
            ? $"{_stepUpReturnTo}#decision-{anchor:N}"
            : _stepUpReturnTo;

    private static string ClassificationSummary(Classification? classification) => classification is null
        ? "not found"
        : classification.Category;

    private static RenderFragment SeverityBadge(Classification? classification) => builder =>
    {
        if (classification is null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "small");
            builder.AddContent(2, "-");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", SeverityCss(classification.Severity));
        builder.AddContent(2, classification.Severity);
        builder.CloseElement();
    };

    private static string SeverityCss(int severity) => severity switch
    {
        >= 7 => "badge badge-red",
        >= 4 => "badge badge-amber",
        _ => "badge",
    };

    private static string WaitingAge(DateTimeOffset createdAt)
    {
        var elapsed = DateTimeOffset.UtcNow - createdAt.ToUniversalTime();
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return elapsed.TotalDays >= 1
            ? $"{(int)elapsed.TotalDays}d {elapsed.Hours}h"
            : elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m"
                : $"{Math.Max(1, elapsed.Minutes)}m";
    }

    private static string ReviewLabel(Decision decision)
    {
        if (decision.SupersededAt is not null)
        {
            return "Superseded";
        }

        if (decision.Outcome != DecisionOutcome.RequireApproval)
        {
            return "-";
        }

        return decision.ReviewOutcome?.ToString() ?? "Needs approval";
    }

    private static string ReviewCss(Decision decision)
    {
        if (decision.SupersededAt is not null)
        {
            return "badge";
        }

        if (decision.Outcome != DecisionOutcome.RequireApproval)
        {
            return "small";
        }

        return decision.ReviewOutcome switch
        {
            DecisionReviewOutcome.Approved => "badge badge-green",
            DecisionReviewOutcome.Rejected => "badge badge-red",
            _ => "badge badge-amber",
        };
    }

    private static bool HasRationale(Decision decision) =>
        !string.IsNullOrWhiteSpace(decision.Rationale);

    private static bool HasDetail(DecisionRow row) =>
        HasRationale(row.Decision) || row.Events.Count > 0;

    private const int MaxInlineEvents = 20;

    private static IReadOnlyList<string> DistinctSourceAddresses(IEnumerable<NormalizedEvent> events) =>
        events
            .SelectMany(evt => evt.Entities)
            .Where(entity => entity.Kind == EntityKind.IpAddress && !string.IsNullOrWhiteSpace(entity.Value))
            .Select(entity => entity.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToArray();

    private string? EventTimeSpan(IReadOnlyList<NormalizedEvent> events)
    {
        if (events.Count == 0)
        {
            return null;
        }

        var earliest = events.Min(evt => evt.OccurredAt);
        var latest = events.Max(evt => evt.OccurredAt);
        return earliest == latest
            ? Display.Format(earliest)
            : $"{Display.Format(earliest)} to {Display.Format(latest)}";
    }

    private IReadOnlyList<PayloadField> NonEmptyPayloadFields(EventPayload payload) =>
        AdminText.PayloadFields(payload, Display.Format)
            .Where(field => !string.IsNullOrWhiteSpace(field.Value))
            .ToArray();

    private async Task<IReadOnlyList<DecisionRow>> BuildRowsAsync(IReadOnlyList<Decision> decisions)
    {
        if (decisions.Count == 0)
        {
            return [];
        }

        var classifications = await ClassificationStore
            .GetManyAsync(decisions.Select(decision => decision.ClassificationId).Distinct().ToArray())
            .ConfigureAwait(false);
        var incidents = await IncidentStore
            .GetManyAsync(classifications.Values
                .Where(classification => classification.SubjectKind == ClassificationSubjectKind.Incident)
                .Select(classification => classification.SubjectId)
                .Distinct()
                .ToArray())
            .ConfigureAwait(false);
        var eventsById = await EventStore
            .GetManyAsync(incidents.Values
                .SelectMany(IncidentEventIds)
                .Distinct()
                .ToArray())
            .ConfigureAwait(false);
        var rows = new List<DecisionRow>(decisions.Count);
        foreach (var decision in decisions)
        {
            classifications.TryGetValue(decision.ClassificationId, out var classification);
            var incident = classification is { SubjectKind: ClassificationSubjectKind.Incident }
                && incidents.TryGetValue(classification.SubjectId, out var foundIncident)
                    ? foundIncident
                    : null;
            var incidentEvents = incident is null
                ? []
                : IncidentEventIds(incident)
                    .Distinct()
                    .Select(id => eventsById.TryGetValue(id, out var found) ? found : null)
                    .Where(found => found is not null)
                    .Select(found => found!)
                    .OrderByDescending(found => found.OccurredAt)
                    .ToArray();
            rows.Add(new DecisionRow(
                decision,
                classification,
                DecisionTriggeredBySummary.Summarize(classification, incident, eventsById),
                BuildReview(decision, classification, incident),
                incidentEvents.Take(MaxInlineEvents).ToArray(),
                incidentEvents.Length,
                incident?.Id));
        }

        return rows;
    }

    private static DecisionRowReview? BuildReview(
        Decision decision,
        Classification? classification,
        Incident? incident)
    {
        if (decision is not { Outcome: DecisionOutcome.RequireApproval, ReviewedAt: null })
        {
            return null;
        }

        var target = classification is null
            ? IncidentTargetIpResult.Unavailable($"Classification {decision.ClassificationId} was not found.")
            : IncidentTargetIp.TryDerive(classification, incident);
        return new DecisionRowReview(target);
    }

    private static IEnumerable<Guid> IncidentEventIds(Incident incident) =>
        incident.EventIds.Concat(incident.Evidence
            .Where(item => item.EventId is not null)
            .Select(item => item.EventId!.Value));

    private static string CurrentListPath(HttpContext context)
    {
        var path = $"{context.Request.PathBase}{context.Request.Path}";
        return string.IsNullOrEmpty(path) ? "/decisions" : path + context.Request.QueryString;
    }

    private async Task<Guid?> PreviousPageCursorAsync(DecisionListFilter filter, ListSort<DecisionSortColumn>? sort)
    {
        var pageNumber = PaginationMath.PageNumber(_page.Preceding, _take);
        return pageNumber <= 1
            ? null
            : await DecisionStore.GetPageCursorAsync((int)Math.Min((long)int.MaxValue, pageNumber - 1), _take, filter, sort)
                .ConfigureAwait(false);
    }

    private static IEnumerable<KeyValuePair<string, string>> ActiveParameters(IReadOnlyDictionary<string, string?> parameters) =>
        parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Key) && !string.IsNullOrWhiteSpace(parameter.Value))
            .Select(parameter => new KeyValuePair<string, string>(parameter.Key, parameter.Value!));

    private sealed record DecisionRow(
        Decision Decision,
        Classification? Classification,
        string TriggeredBy,
        DecisionRowReview? Review,
        IReadOnlyList<NormalizedEvent> Events,
        int TotalEventCount,
        Guid? IncidentId);

    private sealed record DecisionRowReview(IncidentTargetIpResult Target);
}
