@page "/account"
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor
@inject IAdminUserStore Users
@inject IAdminSessionStore Sessions
@inject TotpService Totp
@inject RecoveryCodesCookie RecoveryCodesCookie
@inject NewAppPasswordCookie NewAppPasswordCookie
@inject IAppPasswordStore AppPasswords
@inject IOptions<AdminAuthOptions> AuthOptions
@inject UserDisplay Display

<PageTitle>Account</PageTitle>

<main class="account-panel wide page-layout">
    <nav class="page-index" aria-label="Account sections">
        <a class="index-default-link" href="/account#overview">Overview</a>
        <a href="/account#password">Change password</a>
        <a href="/account#step-up">Step-up verification</a>
        <a href="/account#totp">TOTP</a>
        <a href="/account#security-keys">Security keys</a>
        <a href="/account#recovery-codes">Recovery codes</a>
        <a href="/account#app-passwords">App passwords</a>
        <a href="/account#preferences">Preferences</a>
        <a href="/account#sessions">Active sessions</a>
    </nav>
    <div class="page-content">
    <h1>Admin account</h1>

    <FlashBanner />

    @if (_user is null)
    {
        <p>Account details are not available.</p>
    }
    else
    {
        <section id="overview" class="indexed index-default">
            <h2>Signed in as @_user.Username</h2>
            @if (_user.MustChangePassword)
            {
                <p class="message error">Password change is required before using the admin interface.</p>
            }
            @if (!_user.TotpEnrolled)
            {
                <p class="message error">TOTP enrollment is required before using the admin interface.</p>
            }
            <dl class="detail-list">
                <dt>TOTP</dt><dd>@(_user.TotpEnrolled ? "Enrolled" : "Not enrolled")</dd>
                <dt>Security keys</dt><dd>@_webAuthnCredentials.Count enrolled</dd>
                <dt>Step-up</dt><dd>@(_stepUpFresh ? "Verified for this session" : "Not verified; sensitive changes will prompt")</dd>
                <dt>Active sessions</dt><dd>@_sessions.Count(s => s.RevokedAt is null)</dd>
                <dt>Account created</dt><dd>@Display.Format(_user.CreatedAt)</dd>
                <dt>Password changed</dt><dd>@Display.Format(_user.PasswordChangedAt)</dd>
            </dl>
        </section>

        @if (_newRecoveryCodes.Count > 0)
        {
            <section>
                <h2>Recovery codes</h2>
                <p>Store these now.  They are shown once and each code can be used one time.</p>
                <ul class="recovery-codes">
                    @foreach (var recoveryCode in _newRecoveryCodes)
                    {
                        <li><code>@recoveryCode</code></li>
                    }
                </ul>
            </section>
        }

        <section id="password" class="indexed">
            <h2>Change password</h2>
            <form method="post" action="/auth/password/change">
                <AntiforgeryToken />
                <label>
                    Current password
                    <input name="currentPassword" type="password" autocomplete="current-password" required />
                </label>
                <label>
                    New password
                    <input name="newPassword" type="password" autocomplete="new-password" required minlength="@PasswordPolicy.MinimumLength" />
                </label>
                <label>
                    Confirm new password
                    <input name="confirmPassword" type="password" autocomplete="new-password" required minlength="@PasswordPolicy.MinimumLength" />
                </label>
                <button type="submit">Change password</button>
            </form>
        </section>

        <section id="step-up" class="indexed">
            <h2>Step-up verification</h2>
            @if (_stepUpFresh)
            {
                <p>Step-up is valid for this session.</p>
            }
            else
            {
                <p>Verify TOTP or a security key before changing TOTP enrollment, security keys, or recovery codes.</p>
            }
            <form method="post" action="/auth/step-up">
                <AntiforgeryToken />
                <label>
                    TOTP code
                    <input name="code" inputmode="numeric" autocomplete="one-time-code" required />
                </label>
                <button type="submit">Verify</button>
            </form>
            @if (_webAuthnCredentials.Count > 0)
            {
                <p id="account-webauthn-stepup-message" class="message error" hidden></p>
                <form>
                    <AntiforgeryToken />
                    <button type="button" data-webauthn-assert data-webauthn-message="#account-webauthn-stepup-message">
                        Verify with security key
                    </button>
                </form>
            }
        </section>

        <section id="totp" class="indexed">
            <h2>@(_user.TotpEnrolled ? "Re-enroll TOTP" : "Enroll TOTP")</h2>
            @if (!_user.TotpEnrolled || _stepUpFresh)
            {
                <p>Enter this secret manually in your authenticator app, then verify the current code.</p>
                <pre class="secret-block">@_setupSecret</pre>
                <p class="small">otpauth URI:</p>
                <pre class="secret-block">@_otpUri</pre>
                <form method="post" action="/auth/totp/enroll">
                    <AntiforgeryToken />
                    <input type="hidden" name="setupSecret" value="@_setupSecret" />
                    <label>
                        Verification code
                        <input name="code" inputmode="numeric" autocomplete="one-time-code" required />
                    </label>
                    <button type="submit">@(_user.TotpEnrolled ? "Replace TOTP" : "Enroll TOTP")</button>
                </form>
            }
            else
            {
                <div class="step-up-strip">
                    <span>Re-enrolling TOTP requires step-up verification.</span>
                    <StepUpPrompt ReturnTo="/account#totp" ShowSecurityKey="_webAuthnCredentials.Count > 0" PopoverId="step-up-popover-totp" />
                </div>
            }
        </section>

        <section id="security-keys" class="indexed">
            <h2>Security keys</h2>
            @if (_webAuthnCredentials.Count == 0)
            {
                <p>No security keys are enrolled.</p>
            }
            else
            {
                <ul class="security-keys">
                    @foreach (var credential in _webAuthnCredentials)
                    {
                        <li>
                            <strong>@credential.Name</strong>
                            <span>Created @Display.Format(credential.CreatedAt)</span>
                            <span>
                                Last used @(credential.LastUsedAt is null
                                    ? "never"
                                    : Display.Format(credential.LastUsedAt.Value))
                            </span>
                            @if (_stepUpFresh)
                            {
                                <form method="post" action="/auth/webauthn/delete">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="credentialId" value="@credential.Id" />
                                    <button type="submit">Remove</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }

            @if (_stepUpFresh)
            {
                <p id="account-webauthn-register-message" class="message error" hidden></p>
                <form>
                    <AntiforgeryToken />
                    <label>
                        Security-key label
                        <input id="webauthn-name" name="name" autocomplete="off" maxlength="80" />
                    </label>
                    <button type="button"
                            data-webauthn-register
                            data-webauthn-name="#webauthn-name"
                            data-webauthn-message="#account-webauthn-register-message">
                        Enroll security key
                    </button>
                </form>
            }
            else
            {
                <div class="step-up-strip">
                    <span>Enrolling or removing security keys requires step-up verification.</span>
                    <StepUpPrompt ReturnTo="/account#security-keys" ShowSecurityKey="_webAuthnCredentials.Count > 0" PopoverId="step-up-popover-keys" />
                </div>
            }
        </section>

        <section id="recovery-codes" class="indexed">
            <h2>Recovery codes</h2>
            @if (_stepUpFresh)
            {
                <form method="post" action="/auth/recovery-codes/regenerate">
                    <AntiforgeryToken />
                    <button type="submit">Regenerate recovery codes</button>
                </form>
            }
            else
            {
                <div class="step-up-strip">
                    <span>Regenerating recovery codes requires step-up verification.</span>
                    <StepUpPrompt ReturnTo="/account#recovery-codes" ShowSecurityKey="_webAuthnCredentials.Count > 0" PopoverId="step-up-popover-codes" />
                </div>
            }
        </section>

        <section id="app-passwords" class="indexed">
            <h2>App passwords</h2>
            <p class="small">Read-only API tokens for trusted automation.  A token can read status and list data but can never change anything, never satisfies step-up, and only works from the allowed source networks.</p>
            @if (_newAppPasswordToken is not null)
            {
                <p class="message">Copy this token now.  It is shown once and never again.</p>
                <pre class="secret-block">@_newAppPasswordToken</pre>
            }
            @if (_appPasswords.Count > 0)
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Last used</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appPassword in _appPasswords)
                        {
                            <tr>
                                <td>@appPassword.Name</td>
                                <td>@Display.Format(appPassword.CreatedAt)</td>
                                <td>@(appPassword.ExpiresAt is null ? "never" : Display.Format(appPassword.ExpiresAt.Value))</td>
                                <td>@(appPassword.LastUsedAt is null ? "never" : Display.Format(appPassword.LastUsedAt.Value))</td>
                                <td>
                                    @if (appPassword.RevokedAt is not null)
                                    {
                                        <span class="badge badge-red">Revoked</span>
                                    }
                                    else if (appPassword.ExpiresAt <= DateTimeOffset.UtcNow)
                                    {
                                        <span class="badge badge-amber">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-green">Active</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    @if (appPassword.RevokedAt is null && _stepUpFresh)
                                    {
                                        <form method="post" action="/account/app-passwords/revoke">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="id" value="@appPassword.Id" />
                                            <button type="submit" class="secondary-button">Revoke</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No app passwords have been created.</p>
            }

            @if (_stepUpFresh)
            {
                <form method="post" action="/account/app-passwords/create" class="edit-form">
                    <AntiforgeryToken />
                    <label>
                        Name
                        <input name="name" autocomplete="off" required maxlength="@AdminAppPasswordEndpoints.MaxNameLength" placeholder="copilot-cli" />
                    </label>
                    <button type="submit">Create app password</button>
                </form>
            }
            else
            {
                <div class="step-up-strip">
                    <span>Creating or revoking app passwords requires step-up verification.</span>
                    <StepUpPrompt ReturnTo="/account#app-passwords" ShowSecurityKey="_webAuthnCredentials.Count > 0" PopoverId="step-up-popover-app-passwords" />
                </div>
            }
        </section>

        <section id="preferences" class="indexed">
            <h2>Preferences</h2>
            <form method="post" action="/account/preferences" class="edit-form">
                <AntiforgeryToken />
                <label>
                    Time zone
                    <select name="timeZoneId">
                        @foreach (var zone in _timeZones)
                        {
                            <option value="@zone.Id" selected="@(zone.Id == _preferences.TimeZoneId)">@zone.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Default page size
                    <select name="pageSize">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(size == _preferences.PageSize)">@size</option>
                        }
                    </select>
                </label>
                <label>
                    Status refresh interval
                    <select name="statusRefreshSeconds">
                        @foreach (var seconds in StatusRefreshOptions)
                        {
                            <option value="@seconds" selected="@(seconds == _preferences.StatusRefreshSeconds)">@seconds seconds</option>
                        }
                    </select>
                </label>
                <button type="submit">Save preferences</button>
            </form>
        </section>

        <section id="sessions" class="indexed">
            <h2>Active sessions</h2>
            <form method="post" action="/auth/sessions/revoke">
                <AntiforgeryToken />
                <input type="hidden" name="scope" value="all" />
                <button type="submit">Revoke all sessions</button>
            </form>
            <ul class="sessions">
                @foreach (var session in _sessions)
                {
                    <li>
                        <strong>@session.Ip</strong>
                        <span>@session.UserAgent</span>
                        <span>Last seen @Display.Format(session.LastSeenAt)</span>
                        @if (session.RevokedAt is null)
                        {
                            <form method="post" action="/auth/sessions/revoke">
                                <AntiforgeryToken />
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <button type="submit">Revoke</button>
                            </form>
                        }
                        else
                        {
                            <span>Revoked @Display.Format(session.RevokedAt.Value)</span>
                        }
                    </li>
                }
            </ul>
        </section>

        <section id="sign-out">
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit">Sign out</button>
            </form>
        </section>
    }
    </div>
</main>

@code {
    private AdminUser? _user;
    private AdminSession? _currentSession;
    private IReadOnlyList<AdminSession> _sessions = [];
    private IReadOnlyList<AdminWebAuthnCredential> _webAuthnCredentials = [];
    private IReadOnlyList<string> _newRecoveryCodes = [];
    private IReadOnlyList<AppPassword> _appPasswords = [];
    private string? _newAppPasswordToken;
    private AdminUserPreferences _preferences = new() { UserId = Guid.Empty, UpdatedAt = DateTimeOffset.UtcNow };
    private IReadOnlyList<TimeZoneOption> _timeZones = BuildTimeZoneOptions("UTC");
    private string _setupSecret = string.Empty;
    private string _otpUri = string.Empty;
    private bool _stepUpFresh;
    private static readonly int[] PageSizeOptions = [25, 50, 100, 200];
    private static readonly int[] StatusRefreshOptions = [10, 15, 30, 60, 120, 300];

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        var context = HttpContextAccessor.HttpContext;
        if (context is null)
        {
            return;
        }

        var userIdClaim = context.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(userIdClaim, out var userId))
        {
            return;
        }

        _user = await Users.GetByIdAsync(userId, context.RequestAborted).ConfigureAwait(false);
        if (_user is null)
        {
            return;
        }

        _preferences = await Users.GetPreferencesAsync(userId, context.RequestAborted).ConfigureAwait(false);
        _timeZones = BuildTimeZoneOptions(_preferences.TimeZoneId);
        if (!_timeZones.Any(z => z.Id == _preferences.TimeZoneId))
        {
            _preferences = _preferences with { TimeZoneId = "UTC" };
        }

        _sessions = await Sessions.ListForUserAsync(userId, context.RequestAborted).ConfigureAwait(false);
        _webAuthnCredentials = await Users.ListWebAuthnCredentialsAsync(userId, context.RequestAborted).ConfigureAwait(false);
        var sessionIdClaim = context.User.FindFirstValue(AdminCookieNames.SessionIdClaim);
        if (Guid.TryParse(sessionIdClaim, out var sessionId))
        {
            _currentSession = _sessions.FirstOrDefault(s => s.Id == sessionId);
        }

        _stepUpFresh = _currentSession?.StepUpAt?.Add(AuthOptions.Value.StepUpValidity) >= DateTimeOffset.UtcNow;
        _newRecoveryCodes = RecoveryCodesCookie.ReadAndClear(context);
        _appPasswords = await AppPasswords.ListForUserAsync(userId, context.RequestAborted).ConfigureAwait(false);
        _newAppPasswordToken = NewAppPasswordCookie.ReadAndClear(context);
        if (!_user.TotpEnrolled || _stepUpFresh)
        {
            _setupSecret = Totp.GenerateSecret();
            _otpUri = Totp.BuildOtpAuthUri(_user.Username, _setupSecret);
        }
    }

    private static IReadOnlyList<TimeZoneOption> BuildTimeZoneOptions(string selectedTimeZoneId)
    {
        var zones = TimeZoneInfo.GetSystemTimeZones().ToList();
        if (!zones.Any(z => z.Id == "UTC"))
        {
            zones.Add(TimeZoneInfo.Utc);
        }

        if (!string.IsNullOrWhiteSpace(selectedTimeZoneId)
            && !zones.Any(z => z.Id == selectedTimeZoneId)
            && AdminUserPreferencesValidator.TryResolveTimeZone(selectedTimeZoneId, out var selectedTimeZone))
        {
            zones.Add(selectedTimeZone);
        }

        return zones
            .OrderBy(z => z.BaseUtcOffset)
            .ThenBy(z => z.Id, StringComparer.Ordinal)
            .Select(z => new TimeZoneOption(z.Id, $"{FormatUtcOffset(z.BaseUtcOffset)} {z.DisplayName}"))
            .ToList();
    }

    private static string FormatUtcOffset(TimeSpan offset)
    {
        var sign = offset < TimeSpan.Zero ? '-' : '+';
        var absolute = offset.Duration();
        return $"(UTC{sign}{(int)absolute.TotalHours:00}:{absolute.Minutes:00})";
    }

    private sealed record TimeZoneOption(string Id, string Label);
}
