{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Viegard": {
    "Host": {
      "InstanceId": "",
      "Roles": [ "sources", "correlation", "classification", "policy", "actions" ]
    },
    "Classifiers": {
      "ScoreForFullConfidence": 5.0,
      "SeverityPerScorePoint": 2.0,
      "BlockRecommendationScore": 3.0
    },
    "Policy": {
      "Posture": {
        "DryRun": true,
        "ManualApprovalMode": true,
        "EmergencyStop": false
      }
    },
    "Secrets": {
      "Provider": "configuration"
    },
    "Sources": {
      "Imap": {
        "Accounts": []
      },
      "Syslog": {
        "Enabled": false,
        "ListenAddress": "0.0.0.0",
        "Port": 5514,
        "AllowedSources": [],
        "MaxDatagramBytes": 8192,
        "MaxDatagramsPerSourcePerSecond": 500,
        "NginxAccessTags": [ "nginx_access" ]
      },
      "MDaemon": {
        "Enabled": false,
        "LogDirectory": "",
        "Files": [
          { "Pattern": "MDaemon-*-SMTP-(in).log", "LogKind": "SmtpIn" },
          { "Pattern": "MDaemon-*-SMTP-(out).log", "LogKind": "SmtpOut" },
          { "Pattern": "MDaemon-*-IMAP.log", "LogKind": "Imap" },
          { "Pattern": "MDaemon-*-POP3.log", "LogKind": "Pop3" },
          { "Pattern": "MDaemon-*-Screening.log", "LogKind": "Screening" },
          { "Pattern": "DynScrn-*.log", "LogKind": "DynamicScreening" }
        ],
        "PollInterval": "00:00:05",
        "IncludeNoise": false,
        "IngestExistingOnFirstRun": false
      }
    }
  }
}
