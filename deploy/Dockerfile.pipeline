# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY . .
# The build context excludes .git, so SourceLink cannot read the commit SHA
# directly.  The deploy script writes the clone HEAD to .build-commit before
# building; pass it to publish as SourceRevisionId so the assembly's
# informational version carries the commit.
RUN sha="$(cat .build-commit 2>/dev/null || true)" \
    && dotnet publish src/Viegard.PipelineHost/Viegard.PipelineHost.csproj \
        --configuration Release --output /app ${sha:+-p:SourceRevisionId=$sha}

# Runtime stage
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

# Npgsql probes GSSAPI during connection negotiation; .NET images ship
# without Kerberos libraries (documented .NET 8+ breaking change).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app .

# Run as the non-root user provided by the base image.
USER $APP_UID

ENTRYPOINT ["dotnet", "Viegard.PipelineHost.dll"]
