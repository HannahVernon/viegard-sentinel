@page "/audit"
@attribute [Authorize]
@inject IAuditLedger AuditLedger
@inject UserDisplay Display

<PageTitle>Viegard audit</PageTitle>

<main class="admin-panel wide">
    <h1>Audit</h1>

    <form method="get" action="/audit" class="filter-bar" aria-label="Audit filters">
        <label for="audit-filter-q">
            Search
            <input id="audit-filter-q" name="q" maxlength="@ListFilterText.MaxLength" value="@(_filterText ?? string.Empty)" placeholder="Summary" />
        </label>
        <label for="audit-filter-stage">
            Stage
            <select id="audit-filter-stage" name="stage">
                <option value="" selected="@(_stage is null)">All stages</option>
                @foreach (var stage in Enum.GetValues<PipelineStage>())
                {
                    <option value="@stage" selected="@(_stage == stage)">@stage</option>
                }
            </select>
        </label>
        @foreach (var parameter in ActiveFilterHiddenParams)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <button type="submit">Filter</button>
        <span class="filter-hint">Syntax: term "a phrase" OR other -exclude</span>
        @if (HasFilters)
        {
            <a class="filter-clear" href="/audit">Clear</a>
        }
    </form>

    @if (_page.Items.Count == 0)
    {
        <p>@(HasFilters ? "No audit records match the current filters." : "No audit records are available.")</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <SortHeader Title="Timestamp" SortKey="@ListSortParser.ToQueryKey(AuditSortColumn.Timestamp)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/audit" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="Stage" SortKey="@ListSortParser.ToQueryKey(AuditSortColumn.Stage)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/audit" ExtraQueryParams="@_sortHeaderParams" />
                    <th>Summary</th>
                    <SortHeader Title="Source" SortKey="@ListSortParser.ToQueryKey(AuditSortColumn.Source)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/audit" ExtraQueryParams="@_sortHeaderParams" />
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in _page.Items)
                {
                    <tr>
                        <td>@Display.Format(record.Timestamp)</td>
                        <td>@record.Stage</td>
                        <td>@AdminText.OneLine(record.Summary, 260)</td>
                        <td>@record.SourceId</td>
                        <td>
                            @if (record.EventId is not null)
                            {
                                <a href="/events/@record.EventId">event @AdminText.ShortId(record.EventId.Value)</a>
                            }
                            @if (record.IncidentId is not null)
                            {
                                <a href="/incidents/@record.IncidentId">incident @AdminText.ShortId(record.IncidentId.Value)</a>
                            }
                            @if (record.DecisionId is not null)
                            {
                                <a href="/decisions/@record.DecisionId">decision @AdminText.ShortId(record.DecisionId.Value)</a>
                            }
                            @if (record.ClassificationId is not null)
                            {
                                <span>classification @AdminText.ShortId(record.ClassificationId.Value)</span>
                            }
                            @if (record.ActionId is not null)
                            {
                                <span>action @AdminText.ShortId(record.ActionId.Value)</span>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(record.DetailJson))
                    {
                        <tr class="details-row">
                            <td colspan="5">
                                <details class="json-details">
                                    <summary>Detail</summary>
                                    <pre class="json-block">@AdminText.Limit(record.DetailJson)</pre>
                                </details>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <KeysetPagination BasePath="/audit" CurrentCursor="_currentCursor" PreviousCursor="_previousCursor" NextCursor="_page.NextCursor" Take="_take" TotalCount="_page.TotalCount" Preceding="_page.Preceding" Filters="_filters" />
    }
</main>

@code {
    private KeysetPage<AuditRecord> _page = new([], null, 0, 0);
    private Guid? _currentCursor;
    private Guid? _previousCursor;
    private IReadOnlyDictionary<string, string?> _filters = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _sortHeaderParams = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _filterHiddenParams = new Dictionary<string, string?>();
    private string? _filterText;
    private PipelineStage? _stage;
    private string? _sortKey;
    private SortDirection? _sortDirection;

    private int _take = KeysetPagination.DefaultPageSize;

    private bool HasFilters => _filterText is not null || _stage is not null;

    private IEnumerable<KeyValuePair<string, string>> ActiveFilterHiddenParams => ActiveParameters(_filterHiddenParams);

    [SupplyParameterFromQuery(Name = "take")]
    public int? Take { get; set; }

    [SupplyParameterFromQuery(Name = "cursor")]
    public Guid? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "prev")]
    public Guid? Prev { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "stage")]
    public string? StageRaw { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _take = Take is null ? Display.DefaultPageSize : KeysetPagination.ClampPageSize(Take);
        _filterText = ListFilterText.Normalize(Q);
        _stage = ListFilterParser.ParseEnum<PipelineStage>(StageRaw);
        var sort = ListSortParser.ParseAudit(Sort, Dir);
        _sortKey = sort is { } activeSort ? ListSortParser.ToQueryKey(activeSort.Column) : null;
        _sortDirection = sort?.Direction;
        var direction = _sortDirection is null ? null : ListSortParser.ToQueryValue(_sortDirection.Value);
        var take = _take.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _filters = new Dictionary<string, string?> { ["q"] = _filterText, ["stage"] = _stage?.ToString(), ["sort"] = _sortKey, ["dir"] = direction };
        _sortHeaderParams = new Dictionary<string, string?> { ["q"] = _filterText, ["stage"] = _stage?.ToString(), ["take"] = take };
        _filterHiddenParams = new Dictionary<string, string?> { ["take"] = take, ["sort"] = _sortKey, ["dir"] = direction };
        var filter = new AuditListFilter(_filterText, _stage);
        _currentCursor = Page is { } requestedPage
            ? await AuditLedger.GetPageCursorAsync(requestedPage, _take, filter, sort).ConfigureAwait(false)
            : Cursor;
        _page = await AuditLedger.ListPageAsync(_currentCursor, _take, filter, sort)
            .ConfigureAwait(false);
        _previousCursor = Page is null
            ? Prev
            : await PreviousPageCursorAsync(filter, sort).ConfigureAwait(false);
    }

    private async Task<Guid?> PreviousPageCursorAsync(AuditListFilter filter, ListSort<AuditSortColumn>? sort)
    {
        var pageNumber = PaginationMath.PageNumber(_page.Preceding, _take);
        return pageNumber <= 1
            ? null
            : await AuditLedger.GetPageCursorAsync((int)Math.Min((long)int.MaxValue, pageNumber - 1), _take, filter, sort)
                .ConfigureAwait(false);
    }

    private static IEnumerable<KeyValuePair<string, string>> ActiveParameters(IReadOnlyDictionary<string, string?> parameters) =>
        parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Key) && !string.IsNullOrWhiteSpace(parameter.Value))
            .Select(parameter => new KeyValuePair<string, string>(parameter.Key, parameter.Value!));
}
