@page "/signatures"
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims
@inject ICustomSignatureStore SignatureStore
@inject IAdminUserStore Users
@inject IAdminSessionStore Sessions
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<AdminAuthOptions> AuthOptions
@inject UserDisplay Display

<PageTitle>Viegard signatures</PageTitle>

<main class="admin-panel wide page-layout">
    <nav class="page-index" aria-label="Signature sections">
        <a class="index-default-link" href="/signatures#list">Configured signatures</a>
        <a href="/signatures#add">@(_editing is null ? "Add signature" : "Edit signature")</a>
    </nav>
    <div class="page-content">
    <h1>Detection signatures</h1>

    <FlashBanner />

    @if (!_stepUpFresh)
    {
        <div class="step-up-strip">
            <span>Editing signatures requires step-up verification.</span>
            <StepUpPrompt ReturnTo="/signatures" ShowSecurityKey="_hasSecurityKeys" />
        </div>
    }

    <section id="list" class="indexed index-default">
        <h2>Configured signatures</h2>
        <form method="get" action="/signatures#list" class="filter-bar" aria-label="Signature filters">
            <label for="signature-filter-q">
                Search
                <input id="signature-filter-q" name="q" maxlength="@ListFilterText.MaxLength" value="@(_filterText ?? string.Empty)" placeholder="Name, pattern, or category" />
            </label>
            @foreach (var parameter in ActiveFilterHiddenParams)
            {
                <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
            }
            <button type="submit">Filter</button>
            <span class="filter-hint">Syntax: term "a phrase" OR other -exclude</span>
            @if (HasFilters)
            {
                <a class="filter-clear" href="/signatures#list">Clear</a>
            }
        </form>
        @if (_signatures.Count == 0)
        {
            <p>@(HasFilters ? "No signatures match the current filters." : "No signatures are configured.")</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <SortHeader Title="Name" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Name)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Target" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Target)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Match" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Match)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <th>Pattern</th>
                        <SortHeader Title="Category" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Category)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Severity" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Severity)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Enabled" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Enabled)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Updated" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Updated)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <SortHeader Title="Version" SortKey="@ListSortParser.ToQueryKey(SignatureSortColumn.Version)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/signatures#list" ExtraQueryParams="@_sortHeaderParams" />
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var signature in _signatures)
                    {
                        <tr>
                            <td>@signature.Name</td>
                            <td>@signature.Target</td>
                            <td>@signature.MatchType</td>
                            <td>@AdminText.OneLine(SignaturePatterns(signature), 160)</td>
                            <td>@signature.Category</td>
                            <td>@signature.Severity</td>
                            <td><span class="@(signature.Enabled ? "badge badge-green" : "badge")">@(signature.Enabled ? "Enabled" : "Disabled")</span></td>
                            <td>@signature.UpdatedBy at @Display.Format(signature.UpdatedAt)</td>
                            <td>@signature.Version</td>
                            <td class="actions-cell">
                                <a class="icon-button" href="/signatures?editId=@(signature.Id)#add" data-tip="Edit" aria-label="Edit">
                                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.2 2.1l2.7 2.7L5.4 13.3l-3.3.6.6-3.3z"/><path d="M9.7 3.6l2.7 2.7"/></svg>
                                </a>
                                <form method="post" action="/signatures/toggle">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="id" value="@signature.Id" />
                                    <button type="submit" class="icon-button" data-tip="@(signature.Enabled ? "Disable" : "Enable")" aria-label="@(signature.Enabled ? "Disable" : "Enable")">
                                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 1.8v6"/><path d="M4.3 4.2a5.2 5.2 0 1 0 7.4 0"/></svg>
                                    </button>
                                </form>
                                <form method="post" action="/signatures/delete">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="id" value="@signature.Id" />
                                    <button type="submit" class="icon-button" data-tip="Delete" aria-label="Delete">
                                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.2h11"/><path d="M6 4.2V2.8h4v1.4"/><path d="M4 4.2l.7 9.2h6.6l.7-9.2"/><path d="M6.5 6.8v4.2M9.5 6.8v4.2"/></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <KeysetPagination BasePath="/signatures#list" CurrentCursor="_currentCursor" PreviousCursor="_previousCursor" NextCursor="_page.NextCursor" Take="_take" TotalCount="_page.TotalCount" Preceding="_page.Preceding" Filters="_filters" />
        }
    </section>
    <section id="add" class="indexed">
        <h2>@(_editing is null ? "Add signature" : "Edit signature")</h2>
        <form method="post" action="/signatures/save" class="edit-form">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@FormIdValue" />
            <label>
                Name
                <input name="name" maxlength="@CustomSignature.MaxNameLength" required value="@FormNameValue" />
            </label>
            <label>
                Target
                <select name="target">
                    @foreach (var target in Enum.GetValues<CustomSignatureTarget>())
                    {
                        <option value="@target" selected="@(target == TargetValue)">@target</option>
                    }
                </select>
            </label>
            <label>
                Match type
                <select name="matchType">
                    @foreach (var matchType in Enum.GetValues<CustomSignatureMatchType>())
                    {
                        <option value="@matchType" selected="@(matchType == MatchTypeValue)">@matchType</option>
                    }
                </select>
            </label>
            <p class="form-hint">Patterns are literal, case-insensitive substrings scanned linearly.  They are not regular expressions; characters such as .* or [] are matched as typed.</p>
            <p class="form-hint">The EventKind target matches the namespaced kind name of any event, for example <code>mdaemon/ScreeningBlocked</code>, <code>mdaemon/IpBlocked</code>, <code>admin/LoginFailed</code>, or <code>http/request</code>.  A Prefix match on <code>mdaemon/</code> selects the whole source family.  The Http* targets read fields of HTTP events only.</p>
            <label>
                Pattern (required term 1)
                <input name="pattern" maxlength="@CustomSignature.MaxPatternLength" required value="@PatternValue" />
            </label>
            <label>
                Additional required pattern (term 2, optional)
                <input name="additionalPattern2" maxlength="@CustomSignature.MaxPatternLength" value="@AdditionalPattern2Value" />
            </label>
            <label>
                Additional required pattern (term 3, optional)
                <input name="additionalPattern3" maxlength="@CustomSignature.MaxPatternLength" value="@AdditionalPattern3Value" />
            </label>
            <p class="form-hint">Filling either optional term previews and saves the signature as ContainsAll.  ContainsAll with only term 1 is valid and behaves like Contains.</p>
            <label>
                Category
                <input name="category" maxlength="@CustomSignature.MaxCategoryLength" required value="@CategoryValue" />
            </label>
            <label>
                Severity
                <input name="severity" type="number" min="0" max="10" required value="@SeverityValue" />
            </label>
            <label>
                Evidence weight
                <input name="evidenceWeight" type="number" min="0" max="@CustomSignature.MaxEvidenceWeight" step="0.01" required value="@EvidenceWeightValue" />
                <span class="small">Incident evidence sums across matches and rules; confidence is the sum divided by 5 and severity is twice the sum (each clamped).  A single matched event contributes this full weight, so high weights can reach the configured review or automatic-action gates on their own.</span>
            </label>
            <label class="inline-checkbox">
                <input name="enabled" type="checkbox" value="true" checked="@EnabledValue" />
                Enabled
            </label>
            <div class="button-row">
                <button type="submit">Save signature</button>
                <button type="submit" formaction="/signatures/preview" formmethod="post" class="secondary-button">Preview matches</button>
                @if (_editing is not null)
                {
                    <a class="button-link" href="/signatures#list">Cancel edit</a>
                }
            </div>
        </form>
        @if (_preview is not null)
        {
            <div class="preview-results">
                <h3>Preview matches</h3>
                <p>@PreviewSummary(_preview)</p>
                @if (_preview.Capped)
                {
                    <p class="form-hint">The 10,000 event scan cap was reached.  Older events were not inspected, so this is a bounded preview rather than a full-history count.</p>
                }
                @if (_preview.MatchingEventIds.Count == 0)
                {
                    <p>No matching events were found in the scanned window.</p>
                }
                else
                {
                    <p>Most recent matching events, up to 10:</p>
                    <ol>
                        @foreach (var eventId in _preview.MatchingEventIds)
                        {
                            <li><a href="/events/@eventId">@AdminText.ShortId(eventId)</a></li>
                        }
                    </ol>
                }
            </div>
        }
    </section>
    </div>
</main>

@code {
    private KeysetPage<CustomSignature> _page = new([], null, 0, 0);
    private IReadOnlyList<CustomSignature> _signatures = [];
    private Guid? _currentCursor;
    private Guid? _previousCursor;
    private IReadOnlyDictionary<string, string?> _filters = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _sortHeaderParams = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _filterHiddenParams = new Dictionary<string, string?>();
    private CustomSignature? _editing;
    private bool _stepUpFresh;
    private bool _hasSecurityKeys;
    private string? _filterText;
    private string? _sortKey;
    private SortDirection? _sortDirection;
    private SignaturePreviewView? _preview;

    private int _take = KeysetPagination.DefaultPageSize;

    private bool HasFilters => _filterText is not null;

    private IEnumerable<KeyValuePair<string, string>> ActiveFilterHiddenParams => ActiveParameters(_filterHiddenParams);

    [SupplyParameterFromQuery(Name = "editId")]
    public Guid? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "take")]
    public int? Take { get; set; }

    [SupplyParameterFromQuery(Name = "cursor")]
    public Guid? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "prev")]
    public Guid? Prev { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    [SupplyParameterFromQuery(Name = "form")]
    public string? Form { get; set; }

    [SupplyParameterFromQuery(Name = "formId")]
    public string? FormId { get; set; }

    [SupplyParameterFromQuery(Name = "formName")]
    public string? FormName { get; set; }

    [SupplyParameterFromQuery(Name = "formTarget")]
    public string? FormTarget { get; set; }

    [SupplyParameterFromQuery(Name = "formMatchType")]
    public string? FormMatchType { get; set; }

    [SupplyParameterFromQuery(Name = "formPattern")]
    public string? FormPattern { get; set; }

    [SupplyParameterFromQuery(Name = "formAdditionalPattern2")]
    public string? FormAdditionalPattern2 { get; set; }

    [SupplyParameterFromQuery(Name = "formAdditionalPattern3")]
    public string? FormAdditionalPattern3 { get; set; }

    [SupplyParameterFromQuery(Name = "formCategory")]
    public string? FormCategory { get; set; }

    [SupplyParameterFromQuery(Name = "formSeverity")]
    public string? FormSeverity { get; set; }

    [SupplyParameterFromQuery(Name = "formEvidenceWeight")]
    public string? FormEvidenceWeight { get; set; }

    [SupplyParameterFromQuery(Name = "formEnabled")]
    public string? FormEnabled { get; set; }

    [SupplyParameterFromQuery(Name = "preview")]
    public string? Preview { get; set; }

    [SupplyParameterFromQuery(Name = "previewScanned")]
    public string? PreviewScanned { get; set; }

    [SupplyParameterFromQuery(Name = "previewMatchCount")]
    public string? PreviewMatchCount { get; set; }

    [SupplyParameterFromQuery(Name = "previewCapped")]
    public string? PreviewCapped { get; set; }

    [SupplyParameterFromQuery(Name = "previewNewest")]
    public string? PreviewNewest { get; set; }

    [SupplyParameterFromQuery(Name = "previewOldest")]
    public string? PreviewOldest { get; set; }

    [SupplyParameterFromQuery(Name = "previewMatchIds")]
    public string? PreviewMatchIds { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _take = Take is null ? Display.DefaultPageSize : KeysetPagination.ClampPageSize(Take);
        _filterText = ListFilterText.Normalize(Q);
        var sort = ListSortParser.ParseSignature(Sort, Dir);
        _sortKey = sort is { } activeSort ? ListSortParser.ToQueryKey(activeSort.Column) : null;
        _sortDirection = sort?.Direction;
        var direction = _sortDirection is null ? null : ListSortParser.ToQueryValue(_sortDirection.Value);
        var take = _take.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _filters = new Dictionary<string, string?> { ["q"] = _filterText, ["sort"] = _sortKey, ["dir"] = direction };
        _sortHeaderParams = new Dictionary<string, string?> { ["q"] = _filterText, ["take"] = take };
        _filterHiddenParams = new Dictionary<string, string?> { ["take"] = take, ["sort"] = _sortKey, ["dir"] = direction };
        var filter = new SignatureListFilter(_filterText);
        _currentCursor = Page is { } requestedPage
            ? await SignatureStore.GetPageCursorAsync(requestedPage, _take, filter, sort).ConfigureAwait(false)
            : Cursor;
        _page = await SignatureStore.ListPageAsync(_currentCursor, _take, filter, sort).ConfigureAwait(false);
        _previousCursor = Page is null
            ? Prev
            : await PreviousPageCursorAsync(filter, sort).ConfigureAwait(false);
        _signatures = _page.Items;
        if (EditId is not null)
        {
            _editing = await SignatureStore.GetAsync(EditId.Value).ConfigureAwait(false);
        }

        _preview = ParsePreview();

        var context = HttpContextAccessor.HttpContext;
        if (context is null)
        {
            return;
        }

        if (Guid.TryParse(context.User.FindFirstValue(AdminCookieNames.SessionIdClaim), out var sessionId))
        {
            var session = await Sessions.GetAsync(sessionId).ConfigureAwait(false);
            _stepUpFresh = session?.StepUpAt?.Add(AuthOptions.Value.StepUpValidity) >= DateTimeOffset.UtcNow;
        }

        if (Guid.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            var credentials = await Users.ListWebAuthnCredentialsAsync(userId).ConfigureAwait(false);
            _hasSecurityKeys = credentials.Count > 0;
        }
    }

    private async Task<Guid?> PreviousPageCursorAsync(SignatureListFilter filter, ListSort<SignatureSortColumn>? sort)
    {
        var pageNumber = PaginationMath.PageNumber(_page.Preceding, _take);
        return pageNumber <= 1
            ? null
            : await SignatureStore.GetPageCursorAsync((int)Math.Min((long)int.MaxValue, pageNumber - 1), _take, filter, sort)
                .ConfigureAwait(false);
    }

    private static IEnumerable<KeyValuePair<string, string>> ActiveParameters(IReadOnlyDictionary<string, string?> parameters) =>
        parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Key) && !string.IsNullOrWhiteSpace(parameter.Value))
            .Select(parameter => new KeyValuePair<string, string>(parameter.Key, parameter.Value!));

    private bool HasFormState => string.Equals(Form, "1", StringComparison.Ordinal);

    private string FormIdValue => HasFormState ? FormId ?? string.Empty : _editing?.Id.ToString() ?? string.Empty;

    private string FormNameValue => HasFormState ? FormName ?? string.Empty : _editing?.Name ?? string.Empty;

    private CustomSignatureTarget TargetValue =>
        HasFormState && Enum.TryParse<CustomSignatureTarget>(FormTarget, ignoreCase: true, out var target)
            && Enum.IsDefined(typeof(CustomSignatureTarget), target)
            ? target
            : _editing?.Target ?? CustomSignatureTarget.HttpQuery;

    private CustomSignatureMatchType MatchTypeValue =>
        HasFormState && Enum.TryParse<CustomSignatureMatchType>(FormMatchType, ignoreCase: true, out var matchType)
            && Enum.IsDefined(typeof(CustomSignatureMatchType), matchType)
            ? matchType
            : _editing?.MatchType ?? CustomSignatureMatchType.Contains;

    private string PatternValue => HasFormState ? FormPattern ?? string.Empty : _editing?.Pattern ?? string.Empty;

    private string AdditionalPattern2Value => HasFormState ? FormAdditionalPattern2 ?? string.Empty : EditingAdditionalPattern(0);

    private string AdditionalPattern3Value => HasFormState ? FormAdditionalPattern3 ?? string.Empty : EditingAdditionalPattern(1);

    private string CategoryValue => HasFormState ? FormCategory ?? string.Empty : _editing?.Category ?? string.Empty;

    private string SeverityValue => HasFormState
        ? FormSeverity ?? string.Empty
        : _editing?.Severity.ToString(CultureInfo.InvariantCulture) ?? "3";

    private string EvidenceWeightValue => HasFormState
        ? FormEvidenceWeight ?? string.Empty
        : (_editing?.EvidenceWeight ?? 1.0).ToString(CultureInfo.InvariantCulture);

    private bool EnabledValue => HasFormState
        ? string.Equals(FormEnabled, "true", StringComparison.OrdinalIgnoreCase)
        : _editing?.Enabled ?? true;

    private string EditingAdditionalPattern(int index)
    {
        var patterns = _editing?.AdditionalPatterns ?? [];
        return index >= 0 && index < patterns.Count ? patterns[index] : string.Empty;
    }

    private static string SignaturePatterns(CustomSignature signature) =>
        string.Join(" + ", new[] { signature.Pattern }
            .Concat(signature.AdditionalPatterns ?? [])
            .Where(pattern => !string.IsNullOrWhiteSpace(pattern)));

    private SignaturePreviewView? ParsePreview()
    {
        if (!string.Equals(Preview, "1", StringComparison.Ordinal)
            || !int.TryParse(PreviewScanned, NumberStyles.Integer, CultureInfo.InvariantCulture, out var scanned)
            || !int.TryParse(PreviewMatchCount, NumberStyles.Integer, CultureInfo.InvariantCulture, out var matchCount))
        {
            return null;
        }

        _ = bool.TryParse(PreviewCapped, out var capped);
        return new SignaturePreviewView(
            scanned,
            matchCount,
            ParseTimestamp(PreviewNewest),
            ParseTimestamp(PreviewOldest),
            ParseMatchIds(PreviewMatchIds),
            capped);
    }

    private static IReadOnlyList<Guid> ParseMatchIds(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        var ids = new List<Guid>();
        foreach (var part in value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                ids.Add(id);
            }
        }

        return ids;
    }

    private static DateTimeOffset? ParseTimestamp(string? value) =>
        DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var timestamp)
            ? timestamp
            : null;

    private string PreviewSummary(SignaturePreviewView preview)
    {
        if (preview.ScannedCount == 0)
        {
            return "No stored events were available to scan.";
        }

        var window = preview is { NewestOccurredAt: { } newest, OldestOccurredAt: { } oldest }
            ? $" Window covered: {Display.Format(newest)} through {Display.Format(oldest)}."
            : string.Empty;
        return $"Matched {preview.MatchCount} event(s) while scanning {preview.ScannedCount} recent event(s).{window}";
    }

    private sealed record SignaturePreviewView(
        int ScannedCount,
        int MatchCount,
        DateTimeOffset? NewestOccurredAt,
        DateTimeOffset? OldestOccurredAt,
        IReadOnlyList<Guid> MatchingEventIds,
        bool Capped);
}
