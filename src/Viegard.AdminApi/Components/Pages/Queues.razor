@page "/queues"
@attribute [Authorize]
@inject IQueueTelemetryStore QueueTelemetry
@inject IInstanceRegistryStore InstanceRegistry
@inject IRetentionSettingsStore RetentionSettingsStore
@inject UserDisplay Display

<PageTitle>Viegard queues</PageTitle>

<main class="admin-panel wide page-layout">
    <nav class="page-index" aria-label="Dashboard sections">
        <a class="index-default-link" href="/queues#retention">Retention</a>
        <a href="/queues#queues">Queues</a>
        <a href="/queues#instances">Instances</a>
    </nav>
    <div class="page-content">
    <h1>Dashboard/Queues</h1>

    <section id="retention" class="card indexed index-default">
        <h2>Retention</h2>
        <dl class="detail-list">
            <dt>State</dt><dd>@RetentionState</dd>
            <dt>Effective periods</dt><dd>@RetentionPeriodsSummary</dd>
            <dt>Last cycle</dt><dd data-retention-last-cycle>@RetentionLastCycle</dd>
            <dt>Last rows removed</dt><dd data-retention-total>@RetentionLastCycleTotal</dd>
        </dl>
        <p><a href="/configuration#retention">Edit retention configuration</a></p>
    </section>

    @if (_view.Queues.Count == 0)
    {
        <p>No queue telemetry has been published yet.</p>
    }
    else
    {
        <section id="queues" class="card indexed">
            <h2>Queues</h2>
            <table class="data-table" data-live-queues>
                <caption>Queues are shared across all instances; values come from the freshest report.</caption>
                <thead>
                    <tr>
                        <SortHeader Title="Queue" SortKey="@QueueStatusSortKeys.QueueName" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/queues" />
                        <SortHeader Title="Light" SortKey="@QueueStatusSortKeys.QueueLight" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Depth" SortKey="@QueueStatusSortKeys.QueueDepth" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="In-flight" SortKey="@QueueStatusSortKeys.QueueInFlight" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Oldest pending age" SortKey="@QueueStatusSortKeys.QueueOldestAge" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Dead letters" SortKey="@QueueStatusSortKeys.QueueDeadLetters" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Totals" SortKey="@QueueStatusSortKeys.QueueTotals" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Captured" SortKey="@QueueStatusSortKeys.QueueCaptured" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _view.Queues)
                    {
                        var key = row.Snapshot.QueueName;
                        <tr data-q="@key">
                            <td>@row.Snapshot.QueueName</td>
                            <td><span data-q-cell="light" class="@AdminText.LightCss(row.Status.Light)">@row.Status.Light</span></td>
                            <td data-q-cell="depth">@row.Snapshot.Depth</td>
                            <td data-q-cell="inFlight">@row.Snapshot.InFlight</td>
                            <td data-q-cell="oldestAge">@OldestAge(row.Snapshot)</td>
                            <td data-q-cell="deadLetters">@row.Snapshot.DeadLetterCount</td>
                            <td data-q-cell="totals">@row.Snapshot.TotalEnqueued / @row.Snapshot.TotalCompleted / @row.Snapshot.TotalAbandoned</td>
                            <td data-q-cell="captured">@CapturedBy(row.Snapshot)</td>
                        </tr>
                        <tr class="details-row" data-q-reasons="@key" hidden="@(row.Status.Light == TrafficLight.Green)">
                            <td colspan="8">@string.Join(" ", row.Status.Reasons)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (_view.Instances.Count > 0)
    {
        <section id="instances" class="card indexed">
            <h2>Instances</h2>
            <table class="data-table" data-live-instances>
                <caption>Instances report telemetry every 10 seconds; a stale row means that instance may be down.</caption>
                <thead>
                    <tr>
                        <SortHeader Title="Instance" SortKey="@QueueStatusSortKeys.InstanceId" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/queues" />
                        <SortHeader Title="Version" SortKey="@QueueStatusSortKeys.InstanceVersion" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Started" SortKey="@QueueStatusSortKeys.InstanceStarted" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Queues reported" SortKey="@QueueStatusSortKeys.InstanceQueues" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Last captured" SortKey="@QueueStatusSortKeys.InstanceLastCaptured" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                        <SortHeader Title="Staleness light" SortKey="@QueueStatusSortKeys.InstanceLight" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/queues" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _view.Instances)
                    {
                        <tr data-inst="@row.InstanceId">
                            <td>@row.InstanceId</td>
                            <td data-inst-cell="version" title="@row.VersionTitle">@row.VersionLabel</td>
                            <td data-inst-cell="started">@StartedAge(row)</td>
                            <td data-inst-cell="queuesReported">@row.QueuesReported</td>
                            <td data-inst-cell="lastCaptured">@LastCaptured(row)</td>
                            <td><span data-inst-cell="light" class="@InstanceLightCss(row)">@InstanceLightText(row)</span></td>
                        </tr>
                        <tr class="details-row" data-inst-reasons="@row.InstanceId" hidden="@row.Green">
                            <td colspan="6">@string.Join(" ", row.Reasons)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
    </div>
</main>

@code {
    private QueueStatusView.SnapshotView _view = QueueStatusView.Empty;
    private RetentionSettings? _retentionSettings;
    private IReadOnlyDictionary<RetentionTarget, long> _retentionCounts = RetentionSettings.EmptyCounts();
    private DateTimeOffset _now;
    private string? _sortKey;
    private SortDirection? _sortDirection;

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    private string RetentionState => _retentionSettings is null
        ? "Not seeded"
        : "Configured";

    private string RetentionPeriodsSummary => _retentionSettings is null
        ? "No database-owned settings row exists yet."
        : string.Join("; ", RetentionTargetMetadata.Descriptors.Select(descriptor =>
            $"{descriptor.SettingName}: {FormatPeriod(descriptor.Target)}"));

    private string RetentionLastCycle => _retentionSettings?.LastCycleAt is { } lastCycleAt
        ? Display.Format(lastCycleAt)
        : "Never";

    private string RetentionLastCycleTotal =>
        _retentionCounts.Values.Sum().ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _now = DateTimeOffset.UtcNow;
        _retentionSettings = await RetentionSettingsStore.GetAsync().ConfigureAwait(false);
        _retentionCounts = _retentionSettings?.LastCycleCounts() ?? RetentionSettings.EmptyCounts();
        var snapshots = await QueueTelemetry.GetLatestAsync().ConfigureAwait(false);
        var registrations = await InstanceRegistry.ListAsync().ConfigureAwait(false);
        var sort = QueueStatusSortKeys.Parse(Sort, Dir);
        _sortKey = sort?.Key;
        _sortDirection = sort?.Direction;
        _view = QueueStatusView.Build(snapshots, registrations, _now, sort);
    }

    private string OldestAge(QueueTelemetrySnapshot snapshot) => snapshot.OldestPendingEnqueuedAt is null
        ? ""
        : AdminText.Age(_now - snapshot.OldestPendingEnqueuedAt.Value);

    private string FormatPeriod(RetentionTarget target) =>
        _retentionSettings?.GetDays(target) is { } days
            ? $"{days.ToString(System.Globalization.CultureInfo.InvariantCulture)}d"
            : "forever";

    private string CapturedBy(QueueTelemetrySnapshot snapshot) =>
        $"{Display.Format(snapshot.CapturedAt)} by {snapshot.InstanceId}";

    private string LastCaptured(QueueStatusView.InstanceRow row) =>
        row.LastCapturedAt is { } capturedAt ? Display.Format(capturedAt) : "-";

    private string StartedAge(QueueStatusView.InstanceRow row) =>
        row.StartedAt is { } startedAt ? AdminText.Age(_now - startedAt) : "-";

    private static string InstanceLightText(QueueStatusView.InstanceRow row) =>
        row.Light?.ToString() ?? "-";

    private static string InstanceLightCss(QueueStatusView.InstanceRow row) =>
        row.Light is { } light ? AdminText.LightCss(light) : "badge";
}
