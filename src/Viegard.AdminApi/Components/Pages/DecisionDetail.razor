@page "/decisions/{Id:guid}"
@attribute [Authorize]
@inject IDecisionStore DecisionStore
@inject IClassificationStore ClassificationStore
@inject UserDisplay Display

<PageTitle>Viegard decision</PageTitle>

<main class="admin-panel wide">
    @if (_decision is null)
    {
        <h1>Decision not found</h1>
        <p>The requested decision was not found.</p>
    }
    else
    {
        <Breadcrumbs Ancestors="DecisionBreadcrumbs" Current="@AdminText.ShortId(_decision.Id)" />
        <h1>Decision @AdminText.ShortId(_decision.Id)</h1>
        <dl class="detail-list">
            <dt>Created</dt><dd>@Display.Format(_decision.CreatedAt)</dd>
            <dt>Policy</dt><dd>@_decision.PolicyId @_decision.PolicyVersion</dd>
            <dt>Outcome</dt><dd><span class="@AdminText.OutcomeCss(_decision.Outcome)">@_decision.Outcome</span></dd>
            <dt>Classification</dt><dd>@ClassificationText</dd>
            <dt>Rationale</dt><dd>@AdminText.Limit(_decision.Rationale)</dd>
        </dl>

        @if (_classification is not null)
        {
            <section>
                <h2>Classification</h2>
                <dl class="detail-list">
                    <dt>Category</dt><dd>@_classification.Category</dd>
                    <dt>Severity</dt><dd>@_classification.Severity</dd>
                    <dt>Confidence</dt><dd>@_classification.Confidence.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)</dd>
                    <dt>Subject</dt><dd>@_classification.SubjectKind <a href="/incidents/@_classification.SubjectId">@AdminText.ShortId(_classification.SubjectId)</a></dd>
                </dl>
            </section>
        }

        <section>
            <h2>Guardrails</h2>
            @if (_decision.Guardrails.Count == 0)
            {
                <p>No guardrails are recorded.</p>
            }
            else
            {
                <table class="data-table">
                    <thead><tr><th>Guardrail</th><th>Result</th><th>Detail</th></tr></thead>
                    <tbody>
                        @foreach (var guardrail in _decision.Guardrails)
                        {
                            <tr>
                                <td>@guardrail.GuardrailName</td>
                                <td><span class="@(guardrail.Passed ? "badge badge-green" : "badge badge-red")">@(guardrail.Passed ? "Pass" : "Fail")</span></td>
                                <td>@AdminText.Limit(guardrail.Detail)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</main>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Decision? _decision;
    private Classification? _classification;
    private static readonly BreadcrumbLink[] DecisionBreadcrumbs = [new("Decisions", "/decisions")];

    private string ClassificationText => _classification is null
        ? "not found"
        : $"{_classification.Category} severity {_classification.Severity}";

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _decision = await DecisionStore.GetAsync(Id).ConfigureAwait(false);
        if (_decision is not null)
        {
            _classification = await ClassificationStore.GetAsync(_decision.ClassificationId).ConfigureAwait(false);
        }
    }
}
