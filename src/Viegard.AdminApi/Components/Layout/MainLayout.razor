@inherits LayoutComponentBase
@inject IQueueTelemetryStore QueueTelemetry
@inject UserDisplay Display

<AuthorizeView>
    <Authorized>
        <header class="admin-header">
            <a class="brand" href="/"><img class="brand-mark" src="img/raven.png" alt="" />Viegard</a>
            @* Mobile nav disclosure: a checkbox toggle needs no JavaScript,
               and every navigation is a full page load, so the menu closes
               itself.  Desktop hides the toggle and shows the inline nav. *@
            <input type="checkbox" id="nav-toggle" class="nav-toggle" />
            <label class="nav-toggle-button" for="nav-toggle" aria-label="Toggle navigation menu">&#9776; Menu</label>
            <nav class="admin-nav" aria-label="Admin navigation">
                <a href="/queues">Dashboard/Queues</a>
                <a href="/events">Events</a>
                <a href="/incidents">Incidents</a>
                <a href="/decisions">Decisions</a>
                <a href="/bans">Bans</a>
                <a href="/audit">Audit</a>
                <a href="/errors">Errors</a>
                <a href="/signatures">Signatures</a>
                <a href="/configuration">Configuration</a>
                <a href="/account">Account</a>
            </nav>
            <div class="header-side">
                <span class="refresh-indicator" data-refresh-indicator data-refresh-host="nav" title="Live values refresh automatically." hidden>
                    <span class="refresh-arrow" aria-hidden="true"></span><span data-refresh-age></span>
                </span>
                <a class="status-dot-link" href="/queues" title="Worst queue or instance telemetry light; refreshes every @_refreshSeconds seconds.">
                    <span class="status-dot @_statusCss" data-status-dot data-refresh-ms="@(_refreshSeconds * 1000)"></span><span data-status-label>@_statusLabel</span>
                </a>
                <form method="post" action="/auth/logout" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="button-quiet">Sign out</button>
                </form>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

@Body

@code {
    private string _statusCss = "status-dot-muted";
    private string _statusLabel = "No data";
    private int _refreshSeconds = Viegard.Domain.Admin.AdminUserPreferences.DefaultStatusRefreshSeconds;

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _refreshSeconds = Display.StatusRefreshSeconds;
        var snapshots = await QueueTelemetry.GetLatestAsync().ConfigureAwait(false);
        (_statusCss, _statusLabel) = QueueStatusBadge.Summarize(snapshots, DateTimeOffset.UtcNow);
    }
}
