@page "/incidents"
@attribute [Authorize]
@inject IIncidentStore IncidentStore
@inject UserDisplay Display

<PageTitle>Viegard incidents</PageTitle>

<main class="admin-panel wide">
    <h1>Incidents</h1>

    <form method="get" action="/incidents" class="filter-bar" aria-label="Incident filters">
        <label for="incident-filter-q">
            Search
            <input id="incident-filter-q" name="q" maxlength="@ListFilterText.MaxLength" value="@(_filterText ?? string.Empty)" placeholder="Correlation key" />
        </label>
        <label for="incident-filter-state">
            State
            <select id="incident-filter-state" name="state">
                <option value="" selected="@(_state is null)">All states</option>
                @foreach (var state in Enum.GetValues<IncidentState>())
                {
                    <option value="@state" selected="@(_state == state)">@state</option>
                }
            </select>
        </label>
        @foreach (var parameter in ActiveFilterHiddenParams)
        {
            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
        }
        <button type="submit">Filter</button>
        @if (HasFilters)
        {
            <a class="filter-clear" href="/incidents">Clear</a>
        }
    </form>

    @if (_page.Items.Count == 0)
    {
        <p>@(HasFilters ? "No incidents match the current filters." : "No incidents are available.")</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <SortHeader Title="Correlation key" SortKey="@ListSortParser.ToQueryKey(IncidentSortColumn.CorrelationKey)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/incidents" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="Window" SortKey="@ListSortParser.ToQueryKey(IncidentSortColumn.Window)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Desc" BasePath="/incidents" ExtraQueryParams="@_sortHeaderParams" />
                    <SortHeader Title="State" SortKey="@ListSortParser.ToQueryKey(IncidentSortColumn.State)" CurrentSortKey="@_sortKey" CurrentDirection="@_sortDirection" DefaultDirection="SortDirection.Asc" BasePath="/incidents" ExtraQueryParams="@_sortHeaderParams" />
                    <th>Events</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in _page.Items)
                {
                    <tr>
                        <td><a href="/incidents/@incident.Id">@AdminText.ShortId(incident.Id)</a></td>
                        <td>@AdminText.OneLine(incident.CorrelationKey)</td>
                        <td>@Display.Format(incident.WindowStart) to @Display.Format(incident.WindowEnd)</td>
                        <td>@incident.State</td>
                        <td>@incident.EventIds.Count</td>
                    </tr>
                }
            </tbody>
        </table>
        <KeysetPagination BasePath="/incidents" CurrentCursor="Cursor" PreviousCursor="Prev" NextCursor="_page.NextCursor" Take="_take" TotalCount="_page.TotalCount" Preceding="_page.Preceding" Filters="_filters" />
    }
</main>

@code {
    private KeysetPage<Incident> _page = new([], null, 0, 0);
    private IReadOnlyDictionary<string, string?> _filters = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _sortHeaderParams = new Dictionary<string, string?>();
    private IReadOnlyDictionary<string, string?> _filterHiddenParams = new Dictionary<string, string?>();
    private string? _filterText;
    private IncidentState? _state;
    private string? _sortKey;
    private SortDirection? _sortDirection;

    private int _take = KeysetPagination.DefaultPageSize;

    private bool HasFilters => _filterText is not null || _state is not null;

    private IEnumerable<KeyValuePair<string, string>> ActiveFilterHiddenParams => ActiveParameters(_filterHiddenParams);

    [SupplyParameterFromQuery(Name = "take")]
    public int? Take { get; set; }

    [SupplyParameterFromQuery(Name = "cursor")]
    public Guid? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "prev")]
    public Guid? Prev { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "state")]
    public string? StateRaw { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Display.InitializeAsync().ConfigureAwait(false);
        _take = Take is null ? Display.DefaultPageSize : KeysetPagination.ClampPageSize(Take);
        _filterText = ListFilterText.Normalize(Q);
        _state = ListFilterParser.ParseEnum<IncidentState>(StateRaw);
        var sort = ListSortParser.ParseIncident(Sort, Dir);
        _sortKey = sort is { } activeSort ? ListSortParser.ToQueryKey(activeSort.Column) : null;
        _sortDirection = sort?.Direction;
        var direction = _sortDirection is null ? null : ListSortParser.ToQueryValue(_sortDirection.Value);
        var take = _take.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _filters = new Dictionary<string, string?> { ["q"] = _filterText, ["state"] = _state?.ToString(), ["sort"] = _sortKey, ["dir"] = direction };
        _sortHeaderParams = new Dictionary<string, string?> { ["q"] = _filterText, ["state"] = _state?.ToString(), ["take"] = take };
        _filterHiddenParams = new Dictionary<string, string?> { ["take"] = take, ["sort"] = _sortKey, ["dir"] = direction };
        _page = await IncidentStore.ListPageAsync(Cursor, _take, new IncidentListFilter(_filterText, _state), sort)
            .ConfigureAwait(false);
    }

    private static IEnumerable<KeyValuePair<string, string>> ActiveParameters(IReadOnlyDictionary<string, string?> parameters) =>
        parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Key) && !string.IsNullOrWhiteSpace(parameter.Value))
            .Select(parameter => new KeyValuePair<string, string>(parameter.Key, parameter.Value!));
}
