@page "/configuration"
@attribute [Authorize]
@inject IRetentionSettingsStore RetentionSettingsStore
@inject IJetPackFeedSettingsStore JetPackFeedSettingsStore
@inject ILocalModelAdvisorSettingsStore LocalModelAdvisorSettingsStore
@inject ILocalModelAdvisorCategoryBandStore LocalModelAdvisorCategoryBandStore
@inject ILocalModelAdvisorInjectionPatternStore LocalModelAdvisorInjectionPatternStore
@inject ILocalModelAdvisorPromptTemplateStore LocalModelAdvisorPromptTemplateStore
@inject IPolicyThresholdSettingsStore PolicyThresholdSettingsStore
@inject IClassifierSettingsStore ClassifierSettingsStore
@inject Viegard.Application.Burst.IBurstDetectionSettingsStore BurstDetectionSettingsStore
@inject Viegard.Application.Coalescing.IIncidentCoalescingSettingsStore IncidentCoalescingSettingsStore
@inject ISessionSecuritySettingsStore SessionSecuritySettingsStore
@inject IPolicyPostureSettingsStore PolicyPostureSettingsStore
@inject IIngestionFilterStore IngestionFilters
@inject ISatelliteRoleStore SatelliteRoles
@inject IMikroTikRouterStore Routers
@inject IHostUpgradeCommandStore HostUpgrades
@inject IInstanceRegistryStore InstanceRegistry
@inject IAdminUserStore Users
@inject IAdminSessionStore Sessions
@inject IHttpContextAccessor HttpContextAccessor
@inject SessionSecuritySettingsSource SessionSecuritySettings
@inject IOptions<SessionSecurityOptions> SessionSecurityOptions
@inject IOptions<PolicyOptions> PolicyOptions
@inject IOptions<ClassifierOptions> ClassifierOptions
@inject IOptions<Viegard.Application.Burst.BurstDetectionOptions> BurstDetectionOptions
@inject IOptions<Viegard.Application.Coalescing.IncidentCoalescingOptions> IncidentCoalescingOptions
@inject IOptions<JetPackFeedOptions> JetPackOptions
@inject IOptions<LocalModelAdvisorOptions> LocalModelAdvisorOptions
@inject UserDisplay Display
@inject SatelliteRoleCredentialCookie SatelliteCredentialCookie

<PageTitle>Viegard configuration</PageTitle>

<main class="admin-panel wide page-layout">
    <nav class="page-index" aria-label="Configuration sections">
        <a class="index-default-link" href="/configuration#retention">Retention</a>
        <a href="/configuration#satellites">Satellites</a>
        <a href="/configuration#routers">Routers</a>
        <a href="/configuration#jetpack">JetPack allowlist</a>
        <a href="/configuration#local-model-advisor">Local-model advisor</a>
        <a href="/configuration#upgrades">Upgrades</a>
        <a href="/configuration#classifier-settings">Classifier settings</a>
        <a href="/configuration#burst-detection">Burst detection</a>
        <a href="/configuration#incident-coalescing">Incident coalescing</a>
        <a href="/configuration#session-security">Session security</a>
        <a href="/configuration#thresholds">Policy thresholds</a>
        <a href="/configuration#posture">Policy posture</a>
        <a href="/configuration#ingestion">Ingestion</a>
    </nav>
    <div class="page-content">
    @* No page h1: the highlighted nav item names the page, and the section
       headings carry the structure (operator request, 2026-09-18). *@
    <FlashBanner />

    <section id="retention" class="indexed index-default">
        <h2>Retention</h2>
        <p class="small">Changes apply at the next daily retention cycle.  Blank values keep that table forever.</p>
        <p class="small">Corrections are never purgeable and do not have a retention setting.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@SettingsState</dd>
            <dt>Version</dt><dd>@(_settings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last updated</dt><dd>@LastUpdated</dd>
            <dt>Last cycle</dt><dd>@LastCycle</dd>
            <dt>Last rows removed</dt><dd>@LastCycleTotal</dd>
        </dl>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Target</th>
                    <th>Effective period</th>
                    <th>Last-cycle rows removed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var descriptor in RetentionTargetMetadata.Descriptors)
                {
                    <tr>
                        <td>@descriptor.SettingName</td>
                        <td>@FormatPeriod(descriptor.Target)</td>
                        <td>@FormatLastCycleCount(descriptor.Target)</td>
                    </tr>
                }
            </tbody>
        </table>

        <h3>Edit retention periods</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/retention" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="version" value="@(_settings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                @foreach (var descriptor in RetentionTargetMetadata.Descriptors)
                {
                    <label>
                        @descriptor.Label
                        <input name="@descriptor.SettingName"
                               type="number"
                               min="0"
                               step="1"
                               value="@PeriodValue(descriptor.Target)"
                               placeholder="Keep forever" />
                        <span class="small">@descriptor.HelpText</span>
                    </label>
                }
                <button type="submit">Save retention settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing retention settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#retention" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-retention" />
            </div>
        }

        <h3>Per-category overrides</h3>
        <p class="small">Blank override fields inherit the global local-model advisor settings.  Category labels are open-ended; known deterministic categories are suggested below.</p>
        @if (_localModelAdvisorCategoryBands.Count == 0)
        {
            <p>No category overrides are configured.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Enabled</th>
                        <th>Band</th>
                        <th>Clamp</th>
                        <th>Version</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var band in _localModelAdvisorCategoryBands)
                    {
                        <tr>
                            <td><code>@band.Category</code></td>
                            <td>@FormatNullableBool(band.Enabled)</td>
                            <td>@FormatNullableConfidence(band.InvokeConfidenceMin) to @FormatNullableConfidence(band.InvokeConfidenceMax)</td>
                            <td>Up severity @FormatNullableInt(band.MaxSeverityDelta), up confidence @FormatNullableConfidence(band.MaxConfidenceDelta), down enabled @FormatNullableBool(band.DeEscalationEnabled), down severity @FormatNullableInt(band.MaxDownwardSeverityDelta), down confidence @FormatNullableConfidence(band.MaxDownwardConfidenceDelta)</td>
                            <td>@band.Version.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@band.UpdatedBy at @Display.Format(band.UpdatedAt)</td>
                            <td class="actions-cell">
                                @if (_stepUpFresh)
                                {
                                    <form method="post" action="/configuration/local-model-advisor/category-bands/delete">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="category" value="@band.Category" />
                                        <input type="hidden" name="version" value="@band.Version.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <button type="submit">Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small">Step-up required</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3>Add or edit category override</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/local-model-advisor/category-bands" class="edit-form">
                <AntiforgeryToken />
                <label>
                    Category
                    <input name="category" maxlength="@LocalModelAdvisorCategoryBand.MaxCategoryLength" list="local-model-advisor-known-categories" required placeholder="credential-attack" />
                    <datalist id="local-model-advisor-known-categories">
                        @foreach (var category in LocalModelAdvisorCategoryBand.KnownCategories)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    <span class="small">Enter an existing category to edit it.  Known labels are suggestions, not the full allowed set.</span>
                </label>
                <label>
                    Current version
                    <input name="version" type="number" min="0" step="1" value="0" required />
                    <span class="small">Use 0 for a new override.  For edits, use the version shown in the table.</span>
                </label>
                <label>
                    Enabled override
                    <select name="enabled">
                        <option value="inherit">inherit</option>
                        <option value="true">true</option>
                        <option value="false">false</option>
                    </select>
                </label>
                <label>
                    Invoke confidence minimum
                    <input name="invokeConfidenceMin" type="number" min="0" max="1" step="0.001" placeholder="inherit" />
                </label>
                <label>
                    Invoke confidence maximum
                    <input name="invokeConfidenceMax" type="number" min="0" max="1" step="0.001" placeholder="inherit" />
                </label>
                <label>
                    Max severity delta
                    <input name="maxSeverityDelta" type="number" min="0" max="10" step="1" placeholder="inherit" />
                </label>
                <label>
                    Max confidence delta
                    <input name="maxConfidenceDelta" type="number" min="0" max="1" step="0.001" placeholder="inherit" />
                </label>
                <label>
                    De-escalation enabled override
                    <select name="deEscalationEnabled">
                        <option value="inherit">inherit</option>
                        <option value="true">true</option>
                        <option value="false">false</option>
                    </select>
                </label>
                <label>
                    Max downward severity delta
                    <input name="maxDownwardSeverityDelta" type="number" min="0" max="10" step="1" placeholder="inherit" />
                </label>
                <label>
                    Max downward confidence delta
                    <input name="maxDownwardConfidenceDelta" type="number" min="0" max="1" step="0.001" placeholder="inherit" />
                </label>
                <button type="submit">Save category override</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing local-model advisor category overrides requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#local-model-advisor" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-local-model-advisor-bands" />
            </div>
        }
    </section>

    <section id="satellites" class="indexed">
        <h2>Satellites</h2>
        <p class="small">Manage PostgreSQL roles for Windows satellite pipeline instances.  Use one role per satellite host.</p>

        @if (_satelliteCredential is not null)
        {
            <div class="message">
                <h3>Satellite credential shown once</h3>
                <p>Store this password now.  It cannot be retrieved again; it can only be rotated.</p>
                <dl class="detail-list">
                    <dt>Host</dt><dd>@_satelliteCredential.ConnectionFacts.HostNote</dd>
                    <dt>Port</dt><dd>@(_satelliteCredential.ConnectionFacts.Port.ToString(System.Globalization.CultureInfo.InvariantCulture))</dd>
                    <dt>Database</dt><dd>@_satelliteCredential.ConnectionFacts.Database</dd>
                    <dt>Username</dt><dd>@_satelliteCredential.ConnectionFacts.Username</dd>
                    <dt>Schema</dt><dd>@_satelliteCredential.ConnectionFacts.Schema</dd>
                </dl>
                <p>Password:</p>
                <pre class="secret-block">@_satelliteCredential.Password</pre>
            </div>
        }

        <h3>Existing satellite roles</h3>
        @if (_satelliteRoles.Count == 0)
        {
            <p>No satellite roles are configured.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Role name</th>
                        <th>Login</th>
                        <th>Connection info</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _satelliteRoles)
                    {
                        <tr>
                            <td><code>@role.RoleName</code></td>
                            <td>@(role.CanLogin ? "Enabled" : "Disabled")</td>
                            <td>@role.ConnectionFacts.Hint</td>
                            <td class="actions-cell">
                                @if (_stepUpFresh)
                                {
                                    <form method="post" action="/configuration/satellites/rotate">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="name" value="@role.SatelliteName" />
                                        <button type="submit">Rotate password</button>
                                    </form>
                                    <form method="get" action="/configuration#satellites">
                                        <input type="hidden" name="confirmRevoke" value="@role.SatelliteName" />
                                        <button type="submit">Revoke</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small">Step-up required</span>
                                }
                            </td>
                        </tr>
                        @if (_stepUpFresh && IsConfirmingRevoke(role))
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="message error">
                                        <p>Confirm revocation of <code>@role.RoleName</code>.  Stop the satellite service before revoking an active role.</p>
                                        <form method="post" action="/configuration/satellites/revoke" class="secondary-form">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="name" value="@role.SatelliteName" />
                                            <button type="submit">Confirm revoke</button>
                                            <a class="button-link" href="/configuration#satellites">Cancel</a>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        <h3>Add satellite</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/satellites/create" class="edit-form">
                <AntiforgeryToken />
                <label>
                    Satellite name
                    <input name="name" maxlength="@SatelliteRoleName.MaxNameLength" required placeholder="mdaemon01" />
                    <span class="small">Lowercase letters, digits, and underscores only.  Viegard creates the PostgreSQL role <code>viegard_sat_&lt;name&gt;</code>.</span>
                </label>
                <button type="submit">Add satellite</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Managing satellite roles requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#satellites" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-satellites" />
            </div>
        }
    </section>

    <section id="routers" class="indexed">
        <h2>Routers</h2>
        <p class="small">Manage MikroTik border routers for the future address-list action provider.  The list carries no enforcement behavior until the MikroTik action provider ships in the next increment.</p>

        <h3>Existing routers</h3>
        @if (_routers.Count == 0)
        {
            <p>No routers are configured.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Base URL</th>
                        <th>Transport</th>
                        <th>Enabled</th>
                        <th>Credential</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var router in _routers)
                    {
                        <tr>
                            <td><code>@router.Name</code></td>
                            <td>@router.BaseUrl</td>
                            <td>@TransportDisplay(router)</td>
                            <td>@(router.Enabled ? "Yes" : "No")</td>
                            <td>set</td>
                            <td>@router.UpdatedBy at @Display.Format(router.UpdatedAt)</td>
                            <td class="actions-cell">
                                @if (_stepUpFresh)
                                {
                                    <form method="post" action="/configuration/routers/test">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@router.Id.ToString("N")" />
                                        <button type="submit">Test</button>
                                    </form>
                                    @if (router.TransportMode != MikroTikRouterTransportMode.PlainHttp)
                                    {
                                        <form method="post" action="/configuration/routers/fetch-certificate">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="id" value="@router.Id.ToString("N")" />
                                            <button type="submit">Fetch certificate</button>
                                        </form>
                                    }
                                    <form method="post" action="/configuration/routers/toggle">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@router.Id.ToString("N")" />
                                        <input type="hidden" name="rowVersion" value="@router.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="enabled" value="@((!router.Enabled).ToString())" />
                                        <button type="submit">@(router.Enabled ? "Disable" : "Enable")</button>
                                    </form>
                                    <a class="button-link" href="@RouterEditHref(router)">Edit</a>
                                    <a class="button-link" href="@RouterDeleteHref(router)">Delete</a>
                                }
                                else
                                {
                                    <span class="small">Step-up required</span>
                                }
                            </td>
                        </tr>
                        @if (_stepUpFresh && IsEditing(router))
                        {
                            <tr>
                                <td colspan="7">
                                    <form method="post" action="/configuration/routers/update" class="edit-form">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@router.Id.ToString("N")" />
                                        <input type="hidden" name="rowVersion" value="@router.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <label>
                                            Router name
                                            <input name="name" maxlength="@MikroTikRouter.MaxNameLength" required value="@router.Name" />
                                            <span class="small">Lowercase letters, digits, and hyphens only.</span>
                                        </label>
                                        <label>
                                            Base URL
                                            <input name="baseUrl" required value="@router.BaseUrl" placeholder="http://router.example.com" />
                                            <span class="small">Host and optional port only.  Paths, query strings, fragments, and userinfo are rejected.</span>
                                        </label>
                                        <label>
                                            Transport
                                            <select name="transportMode">
                                                @foreach (var mode in RouterTransportModes)
                                                {
                                                    <option value="@mode" selected="@(mode == EditTransportMode(router))">@TransportOptionLabel(mode)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            Pinned certificate SHA-256
                                            <input name="pinnedCertificateSha256"
                                                   maxlength="64"
                                                   value="@EditPinnedFingerprint(router)"
                                                   placeholder="64 lowercase hex characters" />
                                            <span class="small">Required only for HTTPS pinned.  Use Fetch certificate, then save to pin.</span>
                                        </label>
                                        <label>
                                            Username
                                            <input name="username" maxlength="@MikroTikRouter.MaxUsernameLength" required value="@router.Username" />
                                        </label>
                                        <label>
                                            New password
                                            <input name="password" type="password" autocomplete="new-password" />
                                            <span class="small">Leave blank to keep the existing credential.</span>
                                        </label>
                                        <label class="inline-checkbox">
                                            <input name="enabled" type="checkbox" checked="@router.Enabled" />
                                            Enabled
                                        </label>
                                        <button type="submit">Save router</button>
                                        <a class="button-link" href="/configuration#routers">Cancel</a>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (_stepUpFresh && IsConfirmingDelete(router))
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="message error">
                                        <p>Confirm deletion of router <code>@router.Name</code>.  Stored credentials for this router will be removed.</p>
                                        <form method="post" action="/configuration/routers/delete" class="secondary-form">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="id" value="@router.Id.ToString("N")" />
                                            <input type="hidden" name="rowVersion" value="@router.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                            <button type="submit">Confirm delete</button>
                                            <a class="button-link" href="/configuration#routers">Cancel</a>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        <h3>Add router</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/routers/create" class="edit-form">
                <AntiforgeryToken />
                <label>
                    Router name
                    <input name="name" maxlength="@MikroTikRouter.MaxNameLength" required placeholder="border-1" />
                    <span class="small">Lowercase letters, digits, and hyphens only.  Names must be unique.</span>
                </label>
                <label>
                    Base URL
                    <input name="baseUrl" required placeholder="http://192.0.2.1" />
                    <span class="small">Absolute http or https URL with host and optional port only.</span>
                </label>
                <label>
                    Transport
                    <select name="transportMode">
                        @foreach (var mode in RouterTransportModes)
                        {
                            <option value="@mode">@TransportOptionLabel(mode)</option>
                        }
                    </select>
                </label>
                <label>
                    Pinned certificate SHA-256
                    <input name="pinnedCertificateSha256" maxlength="64" placeholder="64 lowercase hex characters" />
                    <span class="small">Required only for HTTPS pinned.</span>
                </label>
                <label>
                    Username
                    <input name="username" maxlength="@MikroTikRouter.MaxUsernameLength" required placeholder="viegard" />
                </label>
                <label>
                    Password
                    <input name="password" type="password" autocomplete="new-password" required />
                </label>
                <label class="inline-checkbox">
                    <input name="enabled" type="checkbox" checked />
                    Enabled
                </label>
                <button type="submit">Add router</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Managing routers requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#routers" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-routers" />
            </div>
        }
    </section>

    <section id="jetpack" class="indexed">
        <h2>JetPack allowlist</h2>
        <p class="small">JetPack's published IPv4 ranges are fetched on the configured interval and reconciled to the configured MikroTik address list on every enabled router.</p>
        <p class="small">This is a scheduled address-list sync, not a policy decision.  Disabling it pauses both feed fetches and router reconciliation.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@JetPackSettingsState</dd>
            <dt>Version</dt><dd>@(_jetPackSettings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@JetPackLastChanged</dd>
        </dl>

        @if (_jetPackSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the first actions-role fetch cycle unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>FeedUrl</code></td>
                    <td><code>@JetPackCurrentSettings.FeedUrl</code></td>
                    <td>Source JSON feed containing JetPack IPv4 addresses and CIDRs.</td>
                </tr>
                <tr>
                    <td><code>FetchInterval</code></td>
                    <td>@FormatMinutes(JetPackCurrentSettings.FetchInterval)</td>
                    <td>How often the actions role refreshes the desired-address snapshot from JetPack.</td>
                </tr>
                <tr>
                    <td><code>Enabled</code></td>
                    <td><span class="badge">@(JetPackCurrentSettings.Enabled ? "On" : "Off")</span></td>
                    <td>When off, both the feed fetch and the router reconciliation skip their cycles.</td>
                </tr>
                <tr>
                    <td><code>AddressListName</code></td>
                    <td><code>@JetPackCurrentSettings.AddressListName</code></td>
                    <td>RouterOS address list fully owned by the JetPack sync.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit JetPack allowlist settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/jetpack" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="version" value="@(_jetPackSettings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label>
                    Feed URL
                    <input name="feedUrl" value="@JetPackCurrentSettings.FeedUrl" required />
                    <span class="small">Absolute http or https URL returning a JSON string array of IPv4 addresses or CIDRs.</span>
                </label>
                <label>
                    Fetch interval (minutes)
                    <input name="fetchIntervalMinutes"
                           type="number"
                           min="1"
                           step="1"
                           value="@JetPackIntervalMinutes(JetPackCurrentSettings)"
                           required />
                    <span class="small">How often the feed snapshot is refreshed.  Router reconciliation keeps its separate 5-minute cadence.</span>
                </label>
                <label class="checkbox-label">
                    <input name="enabled" type="checkbox" checked="@JetPackCurrentSettings.Enabled" />
                    Enabled
                    <span class="small">When unchecked, the feed fetch and router convergence both skip their cycles.</span>
                </label>
                <label>
                    Address-list name
                    <input name="addressListName" maxlength="@JetPackFeedSettings.MaxAddressListNameLength" value="@JetPackCurrentSettings.AddressListName" required />
                    <span class="small">RouterOS address list name owned by this sync.</span>
                </label>
                <button type="submit">Save JetPack allowlist settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing JetPack allowlist settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#jetpack" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-jetpack" />
            </div>
        }
    </section>

    <section id="local-model-advisor" class="indexed">
        <h2>Local-model advisor</h2>
        <p class="small">The advisor optionally asks a local Ollama model for a second opinion on ambiguous incident classifications.  It is disabled by default, fail-open, clamped, and uses prompt assembly that fences observed evidence as untrusted data.  De-escalation is separately disabled by default.</p>
        <p class="small">The endpoint is runtime configuration.  Use the loopback default until the local workstation endpoint is entered here.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@LocalModelAdvisorSettingsState</dd>
            <dt>Version</dt><dd>@(_localModelAdvisorSettings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@LocalModelAdvisorLastChanged</dd>
            <dt>Prompt template</dt><dd><code>@ActivePromptTemplateVersion</code></dd>
        </dl>

        @if (_localModelAdvisorSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>Enabled</code></td>
                    <td><span class="badge">@(LocalModelAdvisorCurrentSettings.Enabled ? "On" : "Off")</span></td>
                    <td>When off, the deterministic classification is returned unchanged and the model is not called.</td>
                </tr>
                <tr>
                    <td><code>Endpoint</code></td>
                    <td><code>@LocalModelAdvisorCurrentSettings.Endpoint</code></td>
                    <td>Absolute http or https base URL for the local Ollama service.</td>
                </tr>
                <tr>
                    <td><code>Model</code></td>
                    <td><code>@LocalModelAdvisorCurrentSettings.Model</code></td>
                    <td>Ollama model name used for advisory assessment.</td>
                </tr>
                <tr>
                    <td><code>Ambiguous band</code></td>
                    <td>@FormatConfidence(LocalModelAdvisorCurrentSettings.InvokeConfidenceMin) to @FormatConfidence(LocalModelAdvisorCurrentSettings.InvokeConfidenceMax)</td>
                    <td>The advisor is called only when base confidence is inside this inclusive range.</td>
                </tr>
                <tr>
                    <td><code>Clamp</code></td>
                    <td>Severity +@LocalModelAdvisorCurrentSettings.MaxSeverityDelta / -@LocalModelAdvisorCurrentSettings.MaxDownwardSeverityDelta, confidence +@FormatConfidence(LocalModelAdvisorCurrentSettings.MaxConfidenceDelta) / -@FormatConfidence(LocalModelAdvisorCurrentSettings.MaxDownwardConfidenceDelta)</td>
                    <td>Maximum model-suggested movement around the deterministic classification.  Downward movement requires the de-escalation gates.</td>
                </tr>
                <tr>
                    <td><code>Response cache</code></td>
                    <td>@(LocalModelAdvisorCurrentSettings.ResponseCacheEnabled ? "On" : "Off"), @LocalModelAdvisorCurrentSettings.ResponseCacheTtlHours.ToString(System.Globalization.CultureInfo.InvariantCulture) hour(s)</td>
                    <td>When on, equivalent recent prompts reuse the raw validated model output and re-apply current clamp settings.</td>
                </tr>
                <tr>
                    <td><code>Ensemble</code></td>
                    <td>@(LocalModelAdvisorCurrentSettings.EnsembleEnabled ? "On" : "Off")</td>
                    <td>When on, a second local model is consulted and the raw pre-clamp outputs are averaged.</td>
                </tr>
                <tr>
                    <td><code>DeEscalation</code></td>
                    <td>@(LocalModelAdvisorCurrentSettings.DeEscalationEnabled ? "On" : "Off")</td>
                    <td>When on, clean advisor outputs may lower classifications below protected severity @LocalModelAdvisorCurrentSettings.DeEscalationProtectedSeverity when model confidence is at least @FormatConfidence(LocalModelAdvisorCurrentSettings.DeEscalationMinModelConfidence).</td>
                </tr>
                <tr>
                    <td><code>InjectionAction</code></td>
                    <td><code>@LocalModelAdvisorCurrentSettings.InjectionAction</code></td>
                    <td>RecordOnly records detections and continues.  SkipAdvisor records detections and keeps the deterministic classification.</td>
                </tr>
                <tr>
                    <td><code>SecondModelEndpoint</code></td>
                    <td><code>@LocalModelAdvisorCurrentSettings.SecondModelEndpoint</code></td>
                    <td>Absolute http or https base URL for the second model's Ollama service.</td>
                </tr>
                <tr>
                    <td><code>SecondModel</code></td>
                    <td><code>@(string.IsNullOrWhiteSpace(LocalModelAdvisorCurrentSettings.SecondModel) ? "-" : LocalModelAdvisorCurrentSettings.SecondModel)</code></td>
                    <td>Ollama model name used for the second advisory assessment.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit local-model advisor settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/local-model-advisor" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="version" value="@(_localModelAdvisorSettings?.Version.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label class="checkbox-label">
                    <input name="enabled" type="checkbox" checked="@LocalModelAdvisorCurrentSettings.Enabled" />
                    Enabled
                    <span class="small">When unchecked, classification stays deterministic and the model is not called.</span>
                </label>
                <label>
                    Endpoint
                    <input name="endpoint" maxlength="@LocalModelAdvisorSettings.MaxEndpointLength" value="@LocalModelAdvisorCurrentSettings.Endpoint" required />
                    <span class="small">Absolute http or https URL, for example <code>http://127.0.0.1:11434</code>.</span>
                </label>
                <label>
                    Model
                    <input name="model" maxlength="@LocalModelAdvisorSettings.MaxModelLength" value="@LocalModelAdvisorCurrentSettings.Model" required />
                    <span class="small">Ollama model name, for example <code>qwen2.5:7b-instruct</code>.</span>
                </label>
                <label>
                    Temperature
                    <input name="temperature" type="number" min="0" max="2" step="0.01" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.Temperature)" required />
                    <span class="small">Use 0 for deterministic advisory output.</span>
                </label>
                <label>
                    Timeout (ms)
                    <input name="timeoutMs" type="number" min="250" max="120000" step="1" value="@LocalModelAdvisorCurrentSettings.TimeoutMs.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                    <span class="small">Provider failures and timeouts fail open to the deterministic classification.</span>
                </label>
                <label>
                    Keep alive
                    <input name="keepAlive" maxlength="@LocalModelAdvisorSettings.MaxKeepAliveLength" value="@LocalModelAdvisorCurrentSettings.KeepAlive" required />
                    <span class="small">Passed to Ollama as <code>keep_alive</code>.</span>
                </label>
                <label>
                    Invoke confidence minimum
                    <input name="invokeConfidenceMin" type="number" min="0" max="1" step="0.001" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.InvokeConfidenceMin)" required />
                </label>
                <label>
                    Invoke confidence maximum
                    <input name="invokeConfidenceMax" type="number" min="0" max="1" step="0.001" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.InvokeConfidenceMax)" required />
                </label>
                <label>
                    Max severity delta
                    <input name="maxSeverityDelta" type="number" min="0" max="10" step="1" value="@LocalModelAdvisorCurrentSettings.MaxSeverityDelta.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                </label>
                <label>
                    Max confidence delta
                    <input name="maxConfidenceDelta" type="number" min="0" max="1" step="0.001" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.MaxConfidenceDelta)" required />
                </label>
                <label class="checkbox-label">
                    <input name="deEscalationEnabled" type="checkbox" checked="@LocalModelAdvisorCurrentSettings.DeEscalationEnabled" />
                    De-escalation enabled
                    <span class="small">When checked, clean advisor outputs can lower eligible classifications within the configured downward clamp.</span>
                </label>
                <label>
                    Max downward severity delta
                    <input name="maxDownwardSeverityDelta" type="number" min="0" max="10" step="1" value="@LocalModelAdvisorCurrentSettings.MaxDownwardSeverityDelta.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                </label>
                <label>
                    Max downward confidence delta
                    <input name="maxDownwardConfidenceDelta" type="number" min="0" max="1" step="0.001" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.MaxDownwardConfidenceDelta)" required />
                </label>
                <label>
                    De-escalation minimum model confidence
                    <input name="deEscalationMinModelConfidence" type="number" min="0" max="1" step="0.001" value="@FormatConfidence(LocalModelAdvisorCurrentSettings.DeEscalationMinModelConfidence)" required />
                </label>
                <label>
                    De-escalation protected severity
                    <input name="deEscalationProtectedSeverity" type="number" min="0" max="10" step="1" value="@LocalModelAdvisorCurrentSettings.DeEscalationProtectedSeverity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                </label>
                <label class="checkbox-label">
                    <input name="responseCacheEnabled" type="checkbox" checked="@LocalModelAdvisorCurrentSettings.ResponseCacheEnabled" />
                    Response cache enabled
                    <span class="small">When checked, equivalent advisor consults can reuse a recent validated model response.</span>
                </label>
                <label>
                    Response cache TTL (hours)
                    <input name="responseCacheTtlHours" type="number" min="1" max="2160" step="1" value="@LocalModelAdvisorCurrentSettings.ResponseCacheTtlHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                    <span class="small">Default is 72 hours.  Existing entries expire at their saved expiry time.</span>
                </label>
                <label class="checkbox-label">
                    <input name="ensembleEnabled" type="checkbox" checked="@LocalModelAdvisorCurrentSettings.EnsembleEnabled" />
                    Ensemble enabled
                    <span class="small">When checked, the advisor averages primary and second model outputs before applying the bidirectional clamp.</span>
                </label>
                <label>
                    Second model endpoint
                    <input name="secondModelEndpoint" maxlength="@LocalModelAdvisorSettings.MaxEndpointLength" value="@LocalModelAdvisorCurrentSettings.SecondModelEndpoint" />
                    <span class="small">Absolute http or https URL for the second model.  Required only when ensemble is enabled.</span>
                </label>
                <label>
                    Second model
                    <input name="secondModel" maxlength="@LocalModelAdvisorSettings.MaxModelLength" value="@LocalModelAdvisorCurrentSettings.SecondModel" />
                    <span class="small">Ollama model name for the second consult.  Required only when ensemble is enabled.</span>
                </label>
                <label>
                    Prompt-injection action
                    <select name="injectionAction">
                        @foreach (var action in Enum.GetValues<AdvisorInjectionAction>())
                        {
                            <option value="@action" selected="@(LocalModelAdvisorCurrentSettings.InjectionAction == action)">@action</option>
                        }
                    </select>
                    <span class="small">SkipAdvisor is the default fail-safe action when untrusted observed data matches an injection pattern.</span>
                </label>
                <button type="submit">Save local-model advisor settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing local-model advisor settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#local-model-advisor" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-local-model-advisor" />
            </div>
        }

        <h3>Prompt-injection patterns</h3>
        <p class="small">Base patterns are code-defined and cannot be edited here.  Operator-added patterns are additional regexes applied after the base list.</p>
        @if (_localModelAdvisorInjectionPatterns.Count == 0)
        {
            <p>No operator-added injection patterns are configured.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Enabled</th>
                        <th>Pattern</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pattern in _localModelAdvisorInjectionPatterns)
                    {
                        <tr>
                            <td><code>@pattern.Category</code></td>
                            <td>@(pattern.Enabled ? "Yes" : "No")</td>
                            <td><code>@pattern.Pattern</code></td>
                            <td>@pattern.Description</td>
                            <td>@pattern.CreatedBy at @Display.Format(pattern.CreatedAt)</td>
                            <td class="actions-cell">
                                @if (_stepUpFresh)
                                {
                                    <form method="post" action="/configuration/local-model-advisor/injection-patterns/toggle">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@pattern.Id.ToString("N")" />
                                        <input type="hidden" name="enabled" value="@((!pattern.Enabled).ToString())" />
                                        <button type="submit">@(pattern.Enabled ? "Disable" : "Enable")</button>
                                    </form>
                                    <form method="post" action="/configuration/local-model-advisor/injection-patterns/delete">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="id" value="@pattern.Id.ToString("N")" />
                                        <button type="submit">Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small">Step-up required</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/local-model-advisor/injection-patterns" class="edit-form">
                <AntiforgeryToken />
                <label>
                    Category
                    <select name="category">
                        @foreach (var category in Enum.GetNames<AdvisorInjectionPatternCategory>())
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </label>
                <label>
                    Regex
                    <input name="pattern" maxlength="@LocalModelAdvisorInjectionPattern.MaxPatternLength" required />
                    <span class="small">Regexes are compiled case-insensitive and culture-invariant.  Invalid regexes are rejected on save.</span>
                </label>
                <label>
                    Description
                    <input name="description" maxlength="@LocalModelAdvisorInjectionPattern.MaxDescriptionLength" />
                </label>
                <button type="submit">Add injection pattern</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing local-model advisor injection patterns requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#local-model-advisor" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-local-model-advisor-injection" />
            </div>
        }

        <h3>Prompt template</h3>
        <p class="small">Prompt revisions are append-only.  Saving creates a new active revision; activating a prior row changes only the active pointer.</p>
        <p class="small">Allowed placeholders: @AllowedPromptPlaceholders.  The template must include <code>{output_schema}</code>.</p>
        @if (_localModelAdvisorPromptTemplateRevisions.Count == 0)
        {
            <p class="message">No database prompt revision is active.  The code template is being used until the seed worker creates revision 1.</p>
        }
        <table class="data-table">
            <thead>
                <tr>
                    <th>Revision</th>
                    <th>Created</th>
                    <th>Created by</th>
                    <th>Active</th>
                    <th>Note</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var revision in _localModelAdvisorPromptTemplateRevisions)
                {
                    <tr>
                        <td>@revision.Revision.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@Display.Format(revision.CreatedAt)</td>
                        <td>@revision.CreatedBy</td>
                        <td>@(revision.IsActive ? "Yes" : "No")</td>
                        <td>@revision.Note</td>
                        <td class="actions-cell">
                            @if (_stepUpFresh && !revision.IsActive)
                            {
                                <form method="post" action="/configuration/local-model-advisor/prompt-template/activate">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="id" value='@revision.Id.ToString("N")' />
                                    <button type="submit">Activate</button>
                                </form>
                            }
                            else if (!_stepUpFresh)
                            {
                                <span class="small">Step-up required</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/local-model-advisor/prompt-template" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="templateId" value="@AdvisoryIncidentClassifier.PromptTemplateId" />
                <label>
                    System instructions
                    <textarea name="systemInstructions" maxlength="@LocalModelAdvisorPromptTemplateRevision.MaxInstructionsLength" rows="8" required>@PromptSystemInstructions</textarea>
                </label>
                <label>
                    Application instructions
                    <textarea name="applicationInstructions" maxlength="@LocalModelAdvisorPromptTemplateRevision.MaxInstructionsLength" rows="8" required>@PromptApplicationInstructions</textarea>
                </label>
                <label>
                    Admin note
                    <input name="note" maxlength="@LocalModelAdvisorPromptTemplateRevision.MaxNoteLength" placeholder="Reason for this revision" />
                </label>
                <button type="submit">Save prompt template revision</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing the local-model advisor prompt template requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#local-model-advisor" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-local-model-advisor-prompt" />
            </div>
        }
    </section>

    <section id="upgrades" class="indexed">
        <h2>Upgrades</h2>
        <p class="small">Request an upgrade for a Viegard deployment target.  The request is executed by a privileged host-side or satellite-side agent; the admin UI does not receive the Docker socket, Windows elevation rights, or host execution rights.</p>
        <p class="small">The admin UI may briefly disconnect while its own container restarts.  A satellite target only progresses when that Windows host is running the upgrade agent written by the installer.  If no agent is installed for the target, the command remains Pending.</p>

        <h3>Request upgrade</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/upgrades/request" class="secondary-form">
                <AntiforgeryToken />
                <label>
                    Known target
                    <select name="target">
                        @foreach (var target in _hostUpgradeTargets)
                        {
                            <option value="@target">@target</option>
                        }
                    </select>
                </label>
                <label>
                    Or new target
                    <input name="newTarget" maxlength="@HostUpgradeCommandPolicy.MaxTargetLength" pattern="[a-z0-9_-]{1,64}" placeholder="mdaemon-mail01" />
                </label>
                <button type="submit">Request upgrade</button>
                <span class="small">Targets use lowercase letters, digits, dash, and underscore.  Requests are single-flight per target and have a @HostUpgradeCommandPolicy.CooldownMinutes-minute cooldown after completion.</span>
            </form>
            <form method="post" action="/configuration/upgrades/request-all" class="secondary-form">
                <AntiforgeryToken />
                <button type="submit" class="secondary-button">Upgrade all known targets (@_hostUpgradeTargets.Count)</button>
                <span class="small">Queues one request per known target: @string.Join(", ", _hostUpgradeTargets).  Targets already pending, running, or cooling down are skipped and reported.</span>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Requesting a host upgrade requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#upgrades" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-upgrades" />
            </div>
        }

        <h3>Recent upgrade commands</h3>
        <p class="message error" data-upgrades-stale hidden="@(!_hostUpgradeCommands.Any(IsStalePending))">A pending upgrade request is older than @HostUpgradeCommandPolicy.PendingStaleAfterMinutes minutes.  Confirm the host-side or satellite-side agent is installed and running for that target.</p>
        @if (_hostUpgradeCommands.Count == 0)
        {
            <p>No host upgrade commands have been requested.</p>
        }
        else
        {
            <table class="data-table" data-live-upgrades>
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Requested</th>
                        <th>Started</th>
                        <th>Finished</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var command in _hostUpgradeCommands)
                    {
                        <tr data-cmd="@command.Id.ToString("N")">
                            <td>
                                <span class="@StatusCss(command.Status)" data-cmd-cell="status">@command.Status</span>
                                <span class="small">target <code>@command.Target</code></span>
                            </td>
                            <td>@command.RequestedBy at @Display.Format(command.RequestedAt)</td>
                            <td data-cmd-cell="started">@FormatOptionalTimestamp(command.StartedAt)</td>
                            <td data-cmd-cell="finished">@FormatOptionalTimestamp(command.FinishedAt)</td>
                        </tr>
                        <tr class="details-row" data-cmd-detail="@command.Id.ToString("N")" hidden="@(!HasDetail(command.Detail))">
                            <td colspan="4">
                                <details class="json-details">
                                    <summary>Output detail</summary>
                                    <pre class="json-block">@AdminText.Limit(command.Detail)</pre>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="refresh-caption" data-refresh-host="upgrades"><span data-refresh-age></span></p>
        }
    </section>

    <section id="classifier-settings" class="indexed">
        <h2>Classifier settings</h2>
        <p class="small">These settings control deterministic classifier confidence, severity, and IP block recommendations.  Repeat-volume confidence is bounded and does not change severity.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@ClassifierSettingsState</dd>
            <dt>Version</dt><dd>@(_classifierSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@ClassifierSettingsLastChanged</dd>
        </dl>

        @if (_classifierSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>ScoreForFullConfidence</code></td>
                    <td>@FormatConfidence(ClassifierValues.ScoreForFullConfidence)</td>
                    <td>Evidence score that maps to confidence 1.0 before repeat-volume confidence.</td>
                </tr>
                <tr>
                    <td><code>SeverityPerScorePoint</code></td>
                    <td>@FormatConfidence(ClassifierValues.SeverityPerScorePoint)</td>
                    <td>Severity multiplier applied to total evidence score.</td>
                </tr>
                <tr>
                    <td><code>BlockRecommendationScore</code></td>
                    <td>@FormatConfidence(ClassifierValues.BlockRecommendationScore)</td>
                    <td>Minimum evidence score for IP incidents to recommend source blocking.</td>
                </tr>
                <tr>
                    <td><code>RepeatConfidenceMinEvents</code></td>
                    <td>@ClassifierValues.RepeatConfidenceMinEvents.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Minimum correlated event count before repeat-volume confidence can contribute.</td>
                </tr>
                <tr>
                    <td><code>RepeatConfidenceCoefficient</code></td>
                    <td>@FormatConfidence(ClassifierValues.RepeatConfidenceCoefficient)</td>
                    <td>Multiplier applied to log2(correlated event count) for repeat-volume confidence.</td>
                </tr>
                <tr>
                    <td><code>RepeatConfidenceBonusCap</code></td>
                    <td>@FormatConfidence(ClassifierValues.RepeatConfidenceBonusCap)</td>
                    <td>Maximum confidence added by repeat volume.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit classifier settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/classifier-settings" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_classifierSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label>
                    Score for full confidence
                    <input name="scoreForFullConfidence"
                           type="number"
                           min="0.001"
                           step="0.001"
                           value="@FormatConfidence(ClassifierValues.ScoreForFullConfidence)"
                           required />
                    <span class="small">Evidence score that maps to confidence 1.0 before repeat-volume confidence.</span>
                </label>
                <label>
                    Severity per score point
                    <input name="severityPerScorePoint"
                           type="number"
                           min="0.001"
                           step="0.001"
                           value="@FormatConfidence(ClassifierValues.SeverityPerScorePoint)"
                           required />
                    <span class="small">Severity multiplier; this remains independent from the repeat-volume confidence bonus.</span>
                </label>
                <label>
                    Block recommendation score
                    <input name="blockRecommendationScore"
                           type="number"
                           min="0.001"
                           step="0.001"
                           value="@FormatConfidence(ClassifierValues.BlockRecommendationScore)"
                           required />
                    <span class="small">Total score at or above this value recommends source-IP blocking for IP incidents.</span>
                </label>
                <label>
                    Repeat confidence minimum events
                    <input name="repeatConfidenceMinEvents"
                           type="number"
                           min="1"
                           step="1"
                           value="@ClassifierValues.RepeatConfidenceMinEvents.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Correlated event count required before repeat volume adds confidence.</span>
                </label>
                <label>
                    Repeat confidence coefficient
                    <input name="repeatConfidenceCoefficient"
                           type="number"
                           min="0"
                           step="0.001"
                           value="@FormatConfidence(ClassifierValues.RepeatConfidenceCoefficient)"
                           required />
                    <span class="small">Multiplier for log2(event count).</span>
                </label>
                <label>
                    Repeat confidence bonus cap
                    <input name="repeatConfidenceBonusCap"
                           type="number"
                           min="0"
                           max="1"
                           step="0.001"
                           value="@FormatConfidence(ClassifierValues.RepeatConfidenceBonusCap)"
                           required />
                    <span class="small">Maximum confidence bonus from repeated correlated events.</span>
                </label>
                <button type="submit">Save classifier settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing classifier settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#classifier-settings" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-classifier-settings" />
            </div>
        }
    </section>

    <section id="burst-detection" class="indexed">
        <h2>Burst detection</h2>
        <p class="small">Rate-based burst detection counts repeated occurrences of a signal from one source within a sliding window and, when the threshold is reached, proposes an incident for review.  Proposals are review-only unless a signal is explicitly marked action-eligible.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@BurstDetectionSettingsState</dd>
            <dt>Version</dt><dd>@(_burstSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@BurstDetectionSettingsLastChanged</dd>
        </dl>

        @if (_burstSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>GlobalEnabled</code></td>
                    <td>@(BurstValues.GlobalEnabled ? "Enabled" : "Disabled")</td>
                    <td>Master switch for all burst signals.</td>
                </tr>
                <tr>
                    <td><code>AuthFailureEnabled</code></td>
                    <td>@(BurstValues.AuthFailureEnabled ? "Enabled" : "Disabled")</td>
                    <td>Whether repeated admin authentication failures from one source are counted.</td>
                </tr>
                <tr>
                    <td><code>AuthFailureThreshold</code></td>
                    <td>@BurstValues.AuthFailureThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Auth failures from one source within the window that propose an incident.</td>
                </tr>
                <tr>
                    <td><code>AuthFailureWindowSeconds</code></td>
                    <td>@BurstValues.AuthFailureWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Sliding-window length, in seconds, over which auth failures are counted.</td>
                </tr>
                <tr>
                    <td><code>AuthFailureCooldownSeconds</code></td>
                    <td>@BurstValues.AuthFailureCooldownSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Minimum seconds between successive proposals for the same source.</td>
                </tr>
                <tr>
                    <td><code>AuthFailureActionEligible</code></td>
                    <td>@(BurstValues.AuthFailureActionEligible ? "Yes" : "No (propose-only)")</td>
                    <td>Whether a fired proposal may become an unattended action.  Off keeps the signal propose-only.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit burst-detection settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/burst-detection" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_burstSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label class="checkbox-label">
                    <input name="globalEnabled" type="checkbox" value="true" checked="@BurstValues.GlobalEnabled" />
                    Global enabled
                    <span class="small">Master switch for all burst signals.</span>
                </label>
                <label class="checkbox-label">
                    <input name="authFailureEnabled" type="checkbox" value="true" checked="@BurstValues.AuthFailureEnabled" />
                    Auth-failure signal enabled
                    <span class="small">Count repeated admin authentication failures from one source.</span>
                </label>
                <label>
                    Auth-failure threshold
                    <input name="authFailureThreshold"
                           type="number"
                           min="1"
                           step="1"
                           value="@BurstValues.AuthFailureThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Auth failures from one source within the window that propose an incident.</span>
                </label>
                <label>
                    Auth-failure window (seconds)
                    <input name="authFailureWindowSeconds"
                           type="number"
                           min="1"
                           step="1"
                           value="@BurstValues.AuthFailureWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Sliding-window length over which auth failures are counted.</span>
                </label>
                <label>
                    Auth-failure cooldown (seconds)
                    <input name="authFailureCooldownSeconds"
                           type="number"
                           min="0"
                           step="1"
                           value="@BurstValues.AuthFailureCooldownSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Minimum seconds between successive proposals for the same source.</span>
                </label>
                <label class="checkbox-label">
                    <input name="authFailureActionEligible" type="checkbox" value="true" checked="@BurstValues.AuthFailureActionEligible" />
                    Auth-failure action eligible
                    <span class="small">Leave off to keep this signal propose-only.</span>
                </label>
                <button type="submit">Save burst-detection settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing burst-detection settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#burst-detection" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-burst-detection" />
            </div>
        }
    </section>

    <section id="incident-coalescing" class="indexed">
        <h2>Incident coalescing</h2>
        <p class="small">Coalescing merges same-source events that arrive seconds apart into a single incident.  The first event emits an immediate provisional decision; late same-source events extend a settle window and, when it closes, produce one merged final decision that supersedes the still-pending provisional one.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@IncidentCoalescingSettingsState</dd>
            <dt>Version</dt><dd>@(_coalescingSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@IncidentCoalescingSettingsLastChanged</dd>
        </dl>

        @if (_coalescingSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>Enabled</code></td>
                    <td>@(CoalescingValues.Enabled ? "Enabled" : "Disabled")</td>
                    <td>Master switch.  When disabled, correlation uses the classic sliding-window reach check and no coalescing occurs.</td>
                </tr>
                <tr>
                    <td><code>SettleWindowSeconds</code></td>
                    <td>@CoalescingValues.SettleWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Seconds after each absorbed event that the incident stays open for further same-source events before finalizing.</td>
                </tr>
                <tr>
                    <td><code>MaxCoalesceWindowSeconds</code></td>
                    <td>@CoalescingValues.MaxCoalesceWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Upper bound, from the first event, on how long an incident may keep absorbing events.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit incident-coalescing settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/incident-coalescing" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_coalescingSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label class="checkbox-label">
                    <input name="enabled" type="checkbox" value="true" checked="@CoalescingValues.Enabled" />
                    Enabled
                    <span class="small">Master switch for incident coalescing.</span>
                </label>
                <label>
                    Settle window (seconds)
                    <input name="settleWindowSeconds"
                           type="number"
                           min="1"
                           step="1"
                           value="@CoalescingValues.SettleWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Seconds an incident stays open after each absorbed event before finalizing.</span>
                </label>
                <label>
                    Max coalesce window (seconds)
                    <input name="maxCoalesceWindowSeconds"
                           type="number"
                           min="1"
                           step="1"
                           value="@CoalescingValues.MaxCoalesceWindowSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">Upper bound, from the first event, on total absorption time.</span>
                </label>
                <button type="submit">Save incident-coalescing settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing incident-coalescing settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#incident-coalescing" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-incident-coalescing" />
            </div>
        }
    </section>

    <section id="session-security" class="indexed">
        <h2>Session security</h2>
        <p class="small">These tunables govern step-up verification.  Step-up validity is how long a verification stays fresh (each verified action renews the window).  The resume-stash lifetime is how long a step-up-gated action (Approve, Reject, or a settings save) is held so it can be replayed after you complete verification, instead of being discarded.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@SessionSecuritySettingsState</dd>
            <dt>Version</dt><dd>@(_sessionSecuritySettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@SessionSecuritySettingsLastChanged</dd>
        </dl>

        @if (_sessionSecuritySettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next admin-API startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>StepUpValiditySeconds</code></td>
                    <td>@SessionSecurityValues.StepUpValiditySeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Seconds a step-up verification stays valid.  Each verified sensitive action renews the window; idle time beyond this requires a fresh verification.</td>
                </tr>
                <tr>
                    <td><code>ResumeStashTtlSeconds</code></td>
                    <td>@SessionSecurityValues.ResumeStashTtlSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>Seconds a captured step-up-gated action waits to be resumed after verification.  Complete step-up within this window for the original action to replay.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit session-security settings</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/session-security" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_sessionSecuritySettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label>
                    Step-up validity (seconds)
                    <input name="stepUpValiditySeconds"
                           type="number"
                           min="1"
                           step="1"
                           value="@SessionSecurityValues.StepUpValiditySeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">How long a step-up verification stays fresh.</span>
                </label>
                <label>
                    Resume-stash lifetime (seconds)
                    <input name="resumeStashTtlSeconds"
                           type="number"
                           min="1"
                           step="1"
                           value="@SessionSecurityValues.ResumeStashTtlSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">How long a captured action waits to be resumed after verification.</span>
                </label>
                <button type="submit">Save session-security settings</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing session-security settings requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#session-security" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-session-security" />
            </div>
        }
    </section>

    <section id="thresholds" class="indexed">
        <h2>Policy thresholds</h2>
        <p class="small">Review confidence is the propose-for-approval gate.  Action confidence is the automatic-action band; unattended actions remain disabled by posture.</p>
        <p class="small">The minimum severity applies to the AI-backed policy path.  Deterministic classifications keep using their normalized confidence bands.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@ThresholdSettingsState</dd>
            <dt>Version</dt><dd>@(_thresholdSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@ThresholdLastChanged</dd>
        </dl>

        @if (_thresholdSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Knob</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>AiReviewConfidence</code></td>
                    <td>@FormatConfidence(ThresholdValues.ReviewConfidence)</td>
                    <td>Review band entry; propose-for-approval gate.</td>
                </tr>
                <tr>
                    <td><code>AiActionConfidence</code></td>
                    <td>@FormatConfidence(ThresholdValues.ActionConfidence)</td>
                    <td>Automatic-action band entry; unattended actions remain disabled by posture.</td>
                </tr>
                <tr>
                    <td><code>AiActionMinSeverity</code></td>
                    <td>@ThresholdValues.ActionMinSeverity.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>AI-path severity gate.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit policy thresholds</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/thresholds" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_thresholdSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label>
                    Review confidence
                    <input name="reviewConfidence"
                           type="number"
                           min="0"
                           max="1"
                           step="0.001"
                           value="@FormatConfidence(ThresholdValues.ReviewConfidence)"
                           required />
                    <span class="small">Classification confidence at or above this value enters the review band.</span>
                </label>
                <label>
                    Action confidence
                    <input name="actionConfidence"
                           type="number"
                           min="0"
                           max="1"
                           step="0.001"
                           value="@FormatConfidence(ThresholdValues.ActionConfidence)"
                           required />
                    <span class="small">Classification confidence at or above this value enters the automatic-action band; unattended actions remain disabled by posture.</span>
                </label>
                <label>
                    Action minimum severity
                    <input name="actionMinSeverity"
                           type="number"
                           min="@Classification.MinSeverity"
                           max="@Classification.MaxSeverity"
                           step="1"
                           value="@ThresholdValues.ActionMinSeverity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           required />
                    <span class="small">AI-backed classifications below this severity stay record-only even when confidence is high.</span>
                </label>
                <button type="submit">Save policy thresholds</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing policy thresholds requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#thresholds" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-thresholds" />
            </div>
        }
    </section>

    <section id="posture" class="indexed">
        <h2>Policy posture</h2>
        <p class="small">The posture flags govern what happens after a decision.  Dry-run composes router calls without applying them.  Manual approval routes every would-be action to operator review and wins over dry-run in the decision overlay.  Emergency stop refuses all action execution.</p>
        <p class="small">Changes reach the policy engine, action dispatch, ban reconciliation, and JetPack allowlist reconciliation within moments through database notifications with a polling fallback.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Settings row</dt><dd>@PostureSettingsState</dd>
            <dt>Version</dt><dd>@(_postureSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")</dd>
            <dt>Last changed</dt><dd>@PostureLastChanged</dd>
        </dl>

        @if (_postureSettings is null)
        {
            <p class="message">Showing deployment defaults.  The settings row seeds on the next maintenance-role startup unless an admin saves values first.</p>
        }

        <table class="data-table">
            <thead>
                <tr>
                    <th>Flag</th>
                    <th>Effective value</th>
                    <th>Meaning</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>DryRun</code></td>
                    <td><span class="@(PostureValues.DryRun ? "badge badge-green" : "badge badge-red")">@(PostureValues.DryRun ? "On" : "Off - enforcing")</span></td>
                    <td>Actions compose the exact router calls without applying them.  Turning this off makes approved bans real.</td>
                </tr>
                <tr>
                    <td><code>ManualApprovalMode</code></td>
                    <td><span class="badge">@(PostureValues.ManualApprovalMode ? "On" : "Off")</span></td>
                    <td>Every would-be action becomes a decision awaiting operator review.  Wins over dry-run in the decision overlay.</td>
                </tr>
                <tr>
                    <td><code>EmergencyStop</code></td>
                    <td><span class="@(PostureValues.EmergencyStop ? "badge badge-red" : "badge")">@(PostureValues.EmergencyStop ? "ACTIVE" : "Off")</span></td>
                    <td>Refuses all action execution and ban reconciliation until lifted.</td>
                </tr>
            </tbody>
        </table>

        <h3>Edit policy posture</h3>
        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/posture" class="edit-form">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@(_postureSettings?.RowVersion.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                <label class="checkbox-label">
                    <input type="checkbox" name="dryRun" checked="@PostureValues.DryRun" />
                    Dry-run
                    <span class="small">When checked, actions record what they would do and touch nothing.</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" name="manualApprovalMode" checked="@PostureValues.ManualApprovalMode" />
                    Manual approval mode
                    <span class="small">When checked, every would-be action requires operator approval on the decision page.</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" name="emergencyStop" checked="@PostureValues.EmergencyStop" />
                    Emergency stop
                    <span class="small">When checked, all action execution is refused, including reconciliation.</span>
                </label>
                <label>
                    Enforcement confirmation
                    <input name="confirmEnforce" type="text" autocomplete="off" placeholder="Required only when disabling dry-run" />
                    <span class="small">Disabling dry-run makes approved bans real on every enabled router.  Type ENFORCE here to confirm that transition; leave blank otherwise.</span>
                </label>
                <button type="submit">Save policy posture</button>
            </form>
        }
        else
        {
            <div class="step-up-strip">
                <span>Editing the policy posture requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#posture" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-posture" />
            </div>
        }
    </section>

    <section id="ingestion" class="indexed">
        <h2>Ingestion</h2>
        <p class="small">Suppress high-volume MDaemon event kinds at normalization time.  Suppressed kinds are not turned into events or queued for correlation, but raw observations still record every source payload for forensics.</p>
        <p class="small">Changes reach current sources-role instances within moments through database notifications with a polling fallback.  Instances running older builds ignore filters until upgraded.</p>

        <h3>Status</h3>
        <dl class="detail-list">
            <dt>Suppressed MDaemon kinds</dt><dd>@SuppressedMdaemonKinds</dd>
            <dt>Last changed</dt><dd>@MdaemonFiltersLastChanged</dd>
        </dl>

        @if (_stepUpFresh)
        {
            <form method="post" action="/configuration/ingestion" class="edit-form">
                <AntiforgeryToken />
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>MDaemon event kind</th>
                            <th>Current state</th>
                            <th>Suppressed</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var descriptor in MDaemonIngestionFilterPolicy.Descriptors)
                        {
                            <tr>
                                <td><code>@descriptor.EventKindName</code></td>
                                <td>@MdaemonKindState(descriptor)</td>
                                <td>
                                    <input name="suppressed"
                                           type="checkbox"
                                           value="@descriptor.EventKindName"
                                           checked="@IsMdaemonKindSuppressed(descriptor)"
                                           disabled="@descriptor.Locked" />
                                </td>
                                <td>@descriptor.HelpText</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="submit">Save ingestion filters</button>
            </form>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>MDaemon event kind</th>
                        <th>Current state</th>
                        <th>Suppressed</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var descriptor in MDaemonIngestionFilterPolicy.Descriptors)
                    {
                        <tr>
                            <td><code>@descriptor.EventKindName</code></td>
                            <td>@MdaemonKindState(descriptor)</td>
                            <td>@(IsMdaemonKindSuppressed(descriptor) ? "Yes" : "No")</td>
                            <td>@descriptor.HelpText</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="step-up-strip">
                <span>Editing ingestion filters requires step-up verification.</span>
                <StepUpPrompt ReturnTo="/configuration#ingestion" ShowSecurityKey="_hasSecurityKeys" PopoverId="step-up-popover-ingestion" />
            </div>
        }
    </section>

    </div>
</main>

@code {
    private RetentionSettings? _settings;
    private JetPackFeedSettings? _jetPackSettings;
    private LocalModelAdvisorSettings? _localModelAdvisorSettings;
    private IReadOnlyList<LocalModelAdvisorCategoryBand> _localModelAdvisorCategoryBands = [];
    private IReadOnlyList<LocalModelAdvisorInjectionPattern> _localModelAdvisorInjectionPatterns = [];
    private IReadOnlyList<LocalModelAdvisorPromptTemplateRevision> _localModelAdvisorPromptTemplateRevisions = [];
    private PolicyThresholdSettings? _thresholdSettings;
    private ClassifierSettings? _classifierSettings;
    private Viegard.Application.Burst.BurstDetectionSettings? _burstSettings;
    private Viegard.Application.Coalescing.IncidentCoalescingSettings? _coalescingSettings;
    private SessionSecuritySettings? _sessionSecuritySettings;
    private PolicyPostureSettings? _postureSettings;
    private IReadOnlyDictionary<RetentionTarget, long> _lastCycleCounts = RetentionSettings.EmptyCounts();
    private IReadOnlyDictionary<string, IngestionFilter> _mdaemonFilters = new Dictionary<string, IngestionFilter>(StringComparer.Ordinal);
    private IReadOnlyList<SatelliteRoleInfo> _satelliteRoles = [];
    private IReadOnlyList<MikroTikRouter> _routers = [];
    private IReadOnlyList<string> _hostUpgradeTargets = [HostUpgradeCommandPolicy.DefaultTarget];
    private IReadOnlyList<HostUpgradeCommand> _hostUpgradeCommands = [];
    private SatelliteRoleSecret? _satelliteCredential;
    private bool _stepUpFresh;
    private bool _hasSecurityKeys;
    private DateTimeOffset _now;

    [SupplyParameterFromQuery(Name = "confirmRevoke")]
    public string? ConfirmRevoke { get; set; }

    [SupplyParameterFromQuery(Name = "editRouter")]
    public Guid? EditRouter { get; set; }

    [SupplyParameterFromQuery(Name = "confirmDeleteRouter")]
    public Guid? ConfirmDeleteRouter { get; set; }

    [SupplyParameterFromQuery(Name = "routerPin")]
    public string? RouterPin { get; set; }

    private string SettingsState => _settings switch
    {
        null => "Not seeded",
        { SeededAt: { } seededAt } => $"Seeded from deployment configuration at {Display.Format(seededAt)}",
        _ => "Configured in the admin UI before automatic seeding",
    };

    private string LastUpdated => _settings is null
        ? ""
        : $"{_settings.UpdatedBy} at {Display.Format(_settings.UpdatedAt)}";

    private string LastCycle => _settings?.LastCycleAt is { } lastCycleAt
        ? Display.Format(lastCycleAt)
        : "Never";

    private string LastCycleTotal => _lastCycleCounts.Values.Sum().ToString(System.Globalization.CultureInfo.InvariantCulture);

