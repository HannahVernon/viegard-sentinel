{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Viegard": {
    "Admin": {
      "Exposure": "loopback",
      "AllowedSources": [],
      "Auth": {
        "AbsoluteLifetime": "14.00:00:00",
        "IdleTimeout": "48:00:00",
        "IpBindingMode": "strict",
        "StepUpValidity": "00:05:00"
      },
      "Bootstrap": {
        "Username": "admin",
        "PasswordSecretName": "viegard-admin-bootstrap-password"
      }
    },
    "Persistence": {
      "Provider": "inmemory"
    },
    "Secrets": {
      "Provider": "configuration"
    }
  }
}
