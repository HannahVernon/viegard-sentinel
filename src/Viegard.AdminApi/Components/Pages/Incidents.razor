@page "/incidents"
@attribute [Authorize]
@inject IIncidentStore IncidentStore

<PageTitle>Viegard incidents</PageTitle>

<main class="admin-panel wide">
    <h1>Incidents</h1>

    @if (_page.Items.Count == 0)
    {
        <p>No incidents are available.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Correlation key</th>
                    <th>Window</th>
                    <th>State</th>
                    <th>Events</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in _page.Items)
                {
                    <tr>
                        <td><a href="/incidents/@incident.Id">@AdminText.ShortId(incident.Id)</a></td>
                        <td>@AdminText.OneLine(incident.CorrelationKey)</td>
                        <td>@AdminText.Utc(incident.WindowStart) to @AdminText.Utc(incident.WindowEnd)</td>
                        <td>@incident.State</td>
                        <td>@incident.EventIds.Count</td>
                    </tr>
                }
            </tbody>
        </table>
        <KeysetPagination BasePath="/incidents" CurrentCursor="Cursor" PreviousCursor="Prev" NextCursor="_page.NextCursor" />
    }
</main>

@code {
    private KeysetPage<Incident> _page = new([], null);

    [SupplyParameterFromQuery(Name = "cursor")]
    public Guid? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "prev")]
    public Guid? Prev { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _page = await IncidentStore.ListPageAsync(Cursor, 50).ConfigureAwait(false);
    }
}
