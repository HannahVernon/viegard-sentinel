@inject IHttpContextAccessor HttpContextAccessorService

@if (_flash is not null)
{
    @* Rendered as a fixed, out-of-flow toast so its appearance and dismissal
       never shift page content.  role="status" announces it politely without
       stealing focus.  The dismiss button is progressive enhancement (wired by
       list-review.js); with scripting off the success toast still fades on its
       own timer and error toasts persist harmlessly at the top. *@
    <div class="flash-toast @(_flash.IsError ? "flash-toast-error" : null)" role="status" aria-live="polite">
        <p class="@(_flash.IsError ? "message error" : "message")">@_flash.Message</p>
        <button type="button" class="flash-close" data-flash-close aria-label="Dismiss message">&times;</button>
    </div>
}

@code {
    private AdminFlashMessage? _flash;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessorService.HttpContext;
        _flash = context is null ? null : AdminFlashMessages.Consume(context);
    }
}
