# syntax=docker/dockerfile:1
# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY Directory.Build.props nuget.config ./
COPY src/Viegard.Domain/Viegard.Domain.csproj src/Viegard.Domain/
COPY src/Viegard.Application/Viegard.Application.csproj src/Viegard.Application/
COPY src/Viegard.Persistence/Viegard.Persistence.csproj src/Viegard.Persistence/
COPY src/Viegard.Persistence.Postgres/Viegard.Persistence.Postgres.csproj src/Viegard.Persistence.Postgres/
COPY src/Viegard.Sources.Imap/Viegard.Sources.Imap.csproj src/Viegard.Sources.Imap/
COPY src/Viegard.Sources.Syslog/Viegard.Sources.Syslog.csproj src/Viegard.Sources.Syslog/
COPY src/Viegard.Sources.MDaemonLogs/Viegard.Sources.MDaemonLogs.csproj src/Viegard.Sources.MDaemonLogs/
COPY src/Viegard.Actions.MikroTik/Viegard.Actions.MikroTik.csproj src/Viegard.Actions.MikroTik/
COPY src/Viegard.Inference.Ollama/Viegard.Inference.Ollama.csproj src/Viegard.Inference.Ollama/
COPY src/Viegard.PipelineHost/Viegard.PipelineHost.csproj src/Viegard.PipelineHost/
COPY src/Viegard.AdminApi/Viegard.AdminApi.csproj src/Viegard.AdminApi/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet restore src/Viegard.PipelineHost/Viegard.PipelineHost.csproj
COPY . .
# The build context excludes .git, so SourceLink cannot read the commit SHA
# directly.  The deploy script writes the clone HEAD to .build-commit before
# building; pass it to publish as SourceRevisionId so the assembly's
# informational version carries the commit.
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    sha="$(cat .build-commit 2>/dev/null || true)" \
    && dotnet publish src/Viegard.PipelineHost/Viegard.PipelineHost.csproj \
        --configuration Release --no-restore --output /app ${sha:+-p:SourceRevisionId=$sha}

# Runtime stage
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

# Npgsql probes GSSAPI during connection negotiation; .NET images ship
# without Kerberos libraries (documented .NET 8+ breaking change).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app .

# Run as the non-root user provided by the base image.
USER $APP_UID

ENTRYPOINT ["dotnet", "Viegard.PipelineHost.dll"]
