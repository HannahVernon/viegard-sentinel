{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Viegard": {
    "Host": {
      "InstanceId": "",
      "Roles": [ "sources", "correlation", "classification", "policy", "actions" ]
    },
    "Secrets": {
      "Provider": "configuration"
    },
    "Sources": {
      "Imap": {
        "Accounts": []
      },
      "Syslog": {
        "Enabled": false,
        "ListenAddress": "0.0.0.0",
        "Port": 5514,
        "AllowedSources": [],
        "MaxDatagramBytes": 8192,
        "MaxDatagramsPerSourcePerSecond": 500,
        "NginxAccessTags": [ "nginx_access" ]
      }
    }
  }
}
